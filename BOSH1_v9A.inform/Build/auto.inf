[ R_TX_S_263 ;
    #ifdef DEBUG; if (suppress_text_substitution) { print "~The archetypical town hall of the northeastern US, it's a white-sided building the size of a large house, exuding a sense of civic duty. [if location is Main Street 200 block]The front entrance is to the north[otherwise if location is Enigma Park]The back entrance is to the south[otherwise]There are no entrances on this side[end if].~"; rtrue; }
    #endif; ! DEBUG
    ! [1: ~The archetypical town hall of the northeastern US, it's a white-sided building the size of a large house, exuding a sense of civic duty. [if location is Main Street 200 block]The front entrance is to the north[otherwise if location is Enigma Park]The back entrance is to the south[otherwise]There are no entrances on this side[end if].~]
    say__p=1;! [2: ~The archetypical town hall of the northeastern US, it's a white-sided building the size of a large house, exuding a sense of civic duty. ~]
    ParaContent(); print "The archetypical town hall of the northeastern US, it's a white-sided building the size of a large house, exuding a sense of civic duty. ";! [3: if location is main street 200 block]

    	if (~~((((real_location == I587_main_street_200_block))))) jump L_Say2468;! [4: ~The front entrance is to the north~]
    ParaContent(); print "The front entrance is to the north";! [5: otherwise if location is enigma park]
    ParaContent(); 
    	jump L_SayX2395; .L_Say2468; if (~~((((real_location == I591_enigma_park))))) jump L_Say2469;! [6: ~The back entrance is to the south~]
    ParaContent(); print "The back entrance is to the south";! [7: otherwise]

    	jump L_SayX2395; .L_Say2469;! [8: ~There are no entrances on this side~]
    ParaContent(); print "There are no entrances on this side";! [9: end if]

    	.L_Say2470; .L_SayX2395;! [10: ~.~]
    ParaContent(); print "."; .L_Say2471; .L_SayX2396;rtrue;
];
[ R_TX_S_264 ;
    #ifdef DEBUG; if (suppress_text_substitution) { print "~[first time]It's probably beautiful during the day, but tonight the deep shadows among the trees seem ominous. Faraji is watchful and tense as they explore the park.[only]The central focus of the park is a large obelisk inscribed with the names of the town's citizens lost in the Great War. Firs and maples line the paths. The town hall is to the south, and other exits are to the north, west, and east. Other egress is blocked by iron fences[park beam description][if obelisk-ladder is revealed]The obelisk has moved, revealing a ladder leading down into the ground[end if].~"; rtrue; }
    #endif; ! DEBUG
    ! [1: ~[first time]It's probably beautiful during the day, but tonight the deep shadows among the trees seem ominous. Faraji is watchful and tense as they explore the park.^^[only]The central focus of the park is a large obelisk inscribed with the names of the town's citizens lost in the Great War. Firs and maples line the paths. The town hall is to the south, and other exits are to the north, west, and east. Other egress is blocked by iron fences[park beam description][if obelisk-ladder is revealed]^^The obelisk has moved, revealing a ladder leading down into the ground[end if].~]
    say__p=1;! [2: first time]
    ParaContent(); 
    	if ((say__comp == false) && ((I7_ST_say_first_time-->1)++ == 0)) {! [3: ~It's probably beautiful during the day, but tonight the deep shadows among the trees seem ominous. Faraji is watchful and tense as they explore the park.^^~]
    ParaContent(); print "It's probably beautiful during the day, but tonight the deep shadows among the trees seem ominous. Faraji is watchful and tense as they explore the park.^^";! [4: only]
    ParaContent(); }! [5: ~The central focus of the park is a large obelisk inscribed with the names of the town's citizens lost in the Great War. Firs and maples line the paths. The town hall is to the south, and other exits are to the north, west, and east. Other egress is blocked by iron fences~]
    ParaContent(); print "The central focus of the park is a large obelisk inscribed with the names of the town's citizens lost in the Great War. Firs and maples line the paths. The town hall is to the south, and other exits are to the north, west, and east. Other egress is blocked by iron fences";! [6: park beam description]
    ParaContent(); (PHR_1810_r276 ());! [7: if obelisk-ladder is revealed]

    	if (~~(((((Adj_208_t1_v10(I729_obelisk_ladder))))))) jump L_Say2472;! [8: ~^^The obelisk has moved, revealing a ladder leading down into the ground~]
    ParaContent(); print "^^The obelisk has moved, revealing a ladder leading down into the ground";! [9: end if]

    	.L_Say2472; .L_SayX2397;! [10: ~.~]
    ParaContent(); print "."; .L_Say2473; .L_SayX2398;rtrue;
];
[ R_TX_S_265 ;
    #ifdef DEBUG; if (suppress_text_substitution) { print "~From what [we] can make out, it's a clear crystal held aloft by some kind of metal fitting.~"; rtrue; }
