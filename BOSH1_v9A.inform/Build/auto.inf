Constant TX_PS_3690 = "Cranky";
Constant TX_PS_655 = "Crash! Bang! Boom! Kapow! Kerplunk! Andrea D'Andrea's sizzling new guide to onomatopoeia has zing! and zip! and zazzle! A must-read by the former editor of the Zap, North Dakota, Gazette.";
Constant TX_PS_1864 = "Cream-colored plaster walls.";
Constant TX_PS_3447 = "Crop circles are patterns created by the flattening of crops such as wheat, barley, rye, maize, and rapeseed. They are often found in fields in the United Kingdom, but have also been found in other countries. The patterns are said to be the result of the activities of extraterrestrial beings, but have also been attributed to natural phenomena, such as wind, rain, and lightning, and to human activities, such as pranks and hoaxes. Experts point out that many of the circles are too complex to be constructed by humans, and that the crops are often bent, not broken, and that the soil is often undisturbed.";
Constant TX_PS_1483 = "Crop circles";
Constant TX_PS_3691 = "Cross";
Constant TX_PS_3694 = "Crotchety";
Constant TX_PS_1785 = "Crusades";
Constant TX_PS_3693 = "Crusty";
Constant TX_PS_1770 = "Cryptids";
Constant TX_PS_1768 = "Cryptozoology";
Constant TX_PS_3439 = "Crystals are solid materials whose constituents (such as atoms, molecules, or ions) are arranged in a highly ordered microscopic structure, forming a crystal lattice that extends in all directions. Crystals are often used in divination and healing, and are believed to have various properties and powers. For example, amethyst is said to have calming and protective properties, while quartz is said to have healing and energy-amplifying properties. Crystals are also used in various forms of alternative medicine, such as crystal healing, and are often associated with New Age beliefs and practices.";
Constant TX_PS_1474 = "Crystals";
Constant TX_PS_3601 = "Cth";
Constant TX_PS_718 = "DIY";
Constant TX_PS_3595 = "Dag";
Constant TX_PS_1854 = "Damp brick walls, with a few pipes running along them.";
Constant TX_PS_1094 = "Daniels looks weary. He's dressed in a tattered suit, and his hair is unkempt.";
Constant TX_PS_3909 = "Daniels seems to have given Faraji something. Maybe they should look at it.";
Constant TX_PS_357 = "Daniels";
Constant TX_PS_1699 = "Dave Clark Five";
Constant TX_PS_3912 = "Dave at the pawn shop wanted his watch back.";
Constant TX_PS_3375 = "Dave fiddles with a pen. ~How you liking Swamp Park? Heh. Nobody likes Swamp Park.~";
Constant TX_PS_2852 = "Dave grunts, ~Been better.~";
Constant TX_PS_2846 = "Dave grunts, ~Yeah, what of it?~";
Constant TX_PS_2849 = "Dave huffs, ~Miss, everything in this shop is genuine.~";
Constant TX_PS_2008 = "Dave is very particular about his blinds.";
Constant TX_PS_3373 = "Dave leans on the counter. ~Now, the key to breaking and entering is to not get caught.~";
Constant TX_PS_3376 = "Dave looks at the ceiling. ~You know, I've been thinking about getting another tattoo. I think this one will be Snorlax.~";
Constant TX_PS_3377 = "Dave looks at the door. ~I've heard of you BOSH people. You're all kind of crazy, right?~";
Constant TX_PS_1939 = "Dave might object.";
Constant TX_PS_3374 = "Dave rubs his chin thoughtfully. ~That laundromat owner was a strange one. Wrong in the head, I'd say.~";
Constant TX_PS_2856 = "Dave says, ~Dave. I own this place.~";
Constant TX_PS_2850 = "Dave says, ~Depends. How dead do you want'em?~";
Constant TX_PS_2855 = "Dave says, ~Got any jewelry? I'll give you a good price.~";
Constant TX_PS_2854 = "Dave says, ~How should I know? The owner's a weirdo.~";
Constant TX_PS_2858 = "Dave says, ~It was a great place. They sold the best polyester slacks in all of Swamp Park.~";
Constant TX_PS_2851 = "Dave says, ~It's Butterfree, so?~";
Constant TX_PS_2853 = "Dave says, ~It's a Pokémon. I had a phase in the late 90s.~";
Constant TX_PS_2857 = "Dave says, ~Yup. You're the new tenant. I'll miss Angel's.~";
Constant TX_PS_3372 = "Dave scratches his belly. ~I bet you could just buy a screwdriver at the Li'l Nectarine.~";
