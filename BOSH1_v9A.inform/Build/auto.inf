Constant TX_PS_3992 = "It looks like a list of names assigned to days.";
Constant TX_PS_1901 = "It looks like plaster.";
Constant TX_PS_4015 = "It looks like the wires run from the rooftop aerial. Too bad there's no TV to hook up.";
Constant TX_PS_4018 = "It looks like there's a strange socket attached to the aerial.";
Constant TX_PS_3966 = "It might be anywhere, hyperspace or elsewhere.";
Constant TX_PS_4181 = "It pings when Faraji is in the Town Hall, and when they're outside the shack.";
Constant TX_PS_476 = "It says ~Park Place~.";
Constant TX_PS_4208 = "It seems hopeless for Faraji to damage the lizard people quickly enough to win the battle.";
Constant TX_PS_1315 = "It seems like an insect, but with other inscrutable parts, and too large. It's hard to make out the details.";
Constant TX_PS_4178 = "It takes too long to get coffee from Minerva's office to Hutz's shack.";
Constant TX_PS_4202 = "It won't always hit.";
Constant TX_PS_3537 = "It would seem that the phone is locked in Faraji's desk.";
