Object I1158_klimp_s_door ""
    class K4_door
    with short_name BC_12097
    with description BC_12098
    with with_key I1157_klimp_s_key
    has proper
    has scenery
    has ~open
    has openable
    has lockable
    has locked
    with vector 0
    with door_dir [ 
        loc ! room of actor
        ;
        loc = location;
        if (loc == thedark) loc = real_location;
        if (loc == I1197_bosh_office_hallway) return I58_west; return I57_east;],
    with door_to [ 
        loc ! room of actor
        ;
        loc = location;
        if (loc == thedark) loc = real_location;
        if (loc == I1197_bosh_office_hallway) return I1198_bosh_chief_s_office; return I1197_bosh_office_hallway;],
