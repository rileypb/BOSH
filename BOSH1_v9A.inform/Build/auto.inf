Constant TX_PS_761 = "200 block of Main Street";
Constant TX_PS_2128 = "; ";
Constant TX_PS_3509 = "<<< BOSS BATTLE! >>>";
Array TX_L_3509 --> CONSTANT_PACKED_TEXT_STORAGE TX_PS_3509;
Constant TX_PS_4246 = "<<< FARAJI IS DEFEATED! >>>";
Array TX_L_4246 --> CONSTANT_PACKED_TEXT_STORAGE TX_PS_4246;
Constant TX_PS_3502 = "<<< FARAJI IS VICTORIOUS! >>>";
Array TX_L_3502 --> CONSTANT_PACKED_TEXT_STORAGE TX_PS_3502;
Constant TX_PS_3368 = "=";
Constant TX_PS_1811 = ">";
Array TX_L_1811 --> CONSTANT_PACKED_TEXT_STORAGE TX_PS_1811;
Constant TX_PS_1609 = "A Short History of BOSH is a slim volume detailing the Bureau's founding and history from its inception in 1947 to the present day. Chief Klimp has also added his own notes at the end, among which is the following passage:^^~Two years into my tenure saw the election of the stupidest man in government: Senator S. Savra. It's bad enough that no one knows what his first initial stands for, but he's also undeniably a tool of the aliens. He may even be an alien himself. In any case, he's made it his mission to defund the Bureau, and he's been very successful at it. I'm not sure how much longer we can keep the lights on. I'd lay odds that he's been to the Black Knight Satellite.~";
Constant TX_PS_1018 = "A basketball lies on the floor.";
Constant TX_PS_223 = "A battered trade paperback by someone named Rudy Rucker. Its text is protected by copyright.";
Constant TX_PS_1437 = "A black suit, tailored to fit Faraji's slim frame.";
Constant TX_PS_1191 = "A book with a green cover, titled ~The Ecology of Root Vegetables~. The author is listed as Dr. A. Zilman. The book is a comprehensive study of root vegetables. There is a whole chapter on the rutabaga, including its history, cultivation, and uses in various cultures. One passage mentions its potential use as a weapon against ~evil earth demons~.";
Constant TX_PS_1333 = "A bright yellow flower.";
Constant TX_PS_996 = "A broken padlock.";
Constant TX_PS_1573 = "A bunch of cardboard boxes, flattened and stacked.";
Constant TX_PS_1265 = "A button that will take Faraji back to the real world.";
Constant TX_PS_557 = "A cheap ballpoint pen.";
Constant TX_PS_1645 = "A classic of science fiction, this is a novel by Philip K. Dick. Its text is protected by copyright.";
Constant TX_PS_402 = "A coffee table and couch greet visitors to the office, as if any are expected.";
Constant TX_PS_1633 = "A collection of essays debunking the most persistent myths about modern medicine; for example, the existence of the gall bladder. From the chapter on eczema:^^The simple truth is that, as our mothers told us, if we didn't scratch it, it wouldn't itch. The more we scratch, the more it itches. The more it itches, the more we scratch. It's a vicious cycle, but it's not a disease. It's a habit. And habits can be broken.";
Constant TX_PS_1637 = "A collection of essays on the application of speculative reasoning to the investigation of paranormal phenomena. The four principles of applied speculation are:^^1. The principle of extravagance: The more complex the explanation, the more compelling it is. 2. The principle of plausibility: The more plausible the explanation, the more likely it is to be a hoax perpetuated by the government (or a cabal of international elites). 3. The principle of photographic evidence: The more blurry the photograph, the more likely it is to be genuine. 4. The principle of eyewitness testimony: Eyewitnesses are notoriously unreliable, but their accounts are always true. Unless they're lying. Or mistaken. Or hallucinating. Or being controlled by the government (or a cabal of international elites).";
Constant TX_PS_510 = "A desk sits in the corner covered with papers. An opening leads east to the laundromat proper, while a steep set of stairs leads down. The back door is to the south.";
Constant TX_PS_910 = "A dirty shack stands opposite the lake.";
Constant TX_PS_4187 = "A dowsing rod is a tool used to find underground water and other buried things.";
Constant TX_PS_225 = "A drip coffee maker sits on the desk.";
Constant TX_PS_448 = "A few bands of sunlight filter through the blinds. It's not enough to dispel the gloom.";
Constant TX_PS_530 = "A few boxes of supplies sit here and there in the otherwise empty space. Stairs lead up, while a doorway leads south.";
Constant TX_PS_862 = "A few chairs and a table are arranged around the room.";
Constant TX_PS_866 = "A few chairs are arranged around the room.";
Constant TX_PS_852 = "A few items of little value are scattered around the store.";
Constant TX_PS_871 = "A few logs are stacked beside the hearth.";
Constant TX_PS_837 = "A few tables are scattered around the room.";
Constant TX_PS_487 = "A five dollar gift card to the Li'l Nectarine Convenience Store.";
Constant TX_PS_817 = "A floor waxer sits in the center of the gleaming floor.";
Constant TX_PS_17 = "A glass door with a lock and a pull handle.";
Constant TX_PS_18 = "A glass door with a pushbar.";
Constant TX_PS_1010 = "A green key hangs on a hook.";
Constant TX_PS_944 = "A heavy iron key.";
Constant TX_PS_1208 = "A heavy metal door.";
Constant TX_PS_926 = "A heavy sledgehammer, the head of which is covered in rust.";
Constant TX_PS_743 = "A heavy, old-fashioned key, made of copper.";
Constant TX_PS_1220 = "A hole in the roof, through which a pair of insulated wires run. It's not big enough to do anything with.";
Constant TX_PS_578 = "A knockoff of a fancy gaming laptop.";
Constant TX_PS_1162 = "A ladder rests against the wall.";
Constant TX_PS_1164 = "A large blue button, mounted on the wall.";
Constant TX_PS_299 = "A large red button that says ~RESET~.";
Constant TX_PS_49 = "A large, fresh potato.";
Constant TX_PS_1230 = "A light socket for a light bulb.";
Constant TX_PS_1188 = "A long orange extension cord, with a plug on one end and a socket on the other.";
Constant TX_PS_1635 = "A look at the various Native American tribes of New York state, from the pre-Columbian era to the present day. The chapter on the Onondaga tribe reads:^^The Onondaga tribe is one of the original five tribes of the Iroquois Confederacy. They are known for their longhouses, which can be up to 200 feet long, and for their traditional government, which is based on a system of clans. The Onondaga are also known for their traditional arts and crafts, such as beadwork, pottery, and basketry. There is no truth to the rumors that the ancient Onondaga consorted with lizard people.";
Constant TX_PS_919 = "A mangy, old, stripey orange cat.";
Constant TX_PS_574 = "A medium-length flat head screwdriver with a red plastic handle.";
Constant TX_PS_1639 = "A memoir of a summer spent biking around the islands of the Puget Sound. The chapter on Orcas Island reads:^^Upon disembarking from the ferry on Orcas, I became aware that Spooney had fallen ill with some kind of stomach bug. He was barely able to mount his bike, and we had to stop every few minutes so he could vomit. We barely reached the campground before dark. By this time the sensation I'd had on Waldron Island had grown stronger, and I was convinced that we were being followed. I was reminded of an experience I'd had as a child in upstate New York, when I'd been convinced that a ghost of an Onondaga warrior was following me. Spooney was convinced that our pursuer was a lizard person. I argued that this was ridiculous, but Spooney reminded me of the principle of extravagance, and I had to admit that he had a point. In any case, Spooney was worse the next morning, and I had to leave him or risk missing the ferry. I never saw him again.";
Constant TX_PS_1161 = "A metal ladder, about 6 feet long. It looks sturdy and well-maintained.";
Constant TX_PS_781 = "A mixture of sturdy firs and maples, unaware of the pending cataclysm.";
Constant TX_PS_1133 = "A modest wooden door leads into the Horton family house. It has been fitted with a modern lock.";
Constant TX_PS_1185 = "A narrow staircase leads down.";
Constant TX_PS_873 = "A narrow staircase leads up.";
Constant TX_PS_835 = "A number of comfortable chairs are arranged around the room.";
Constant TX_PS_1020 = "A number of weight machines and free weights are arranged around a padded area separated from the basketball court.";
Constant TX_PS_1015 = "A pair of basketball hoops are mounted at either end of the court.";
Constant TX_PS_1075 = "A pair of bolt cutters, with long handles and heavy jaws.";
Constant TX_PS_1226 = "A pair of insulated wires, running from the antenna and through a hole in the roof.";
Constant TX_PS_917 = "A pile of used paper coffee cups. This guy must love his coffee.";
Constant TX_PS_1009 = "A plain green key.";
Constant TX_PS_1550 = "A print of a beautiful green pheasant in a tree, by the 19th century Japanese artist Utagawa Hiroshige.";
Constant TX_PS_47 = "A rather large, hefty turnip.";
Constant TX_PS_1234 = "A red enameled base, scuffed and tarnished. It reads ~Spectre~.";
Constant TX_PS_1017 = "A regulation basketball, well-worn but fully inflated.";
Constant TX_PS_1658 = "A relic of the Chief's sacred geometry phase.";
Constant TX_PS_804 = "A road can be seen to the east.";
Constant TX_PS_1052 = "A rod of blackened wood, it seems to pulse with a vital energy.";
Constant TX_PS_810 = "A scuffed-up table lamp sits discarded in a corner.";
Constant TX_PS_1024 = "A set of free weights, ranging from 5 to 50 pounds.";
Constant TX_PS_1092 = "A shimmering portal hovers in the center of the chamber, casting a faint light over the room.";
Constant TX_PS_1169 = "A shovel lies on the ground, forgotten.";
Constant TX_PS_905 = "A simple brass key.";
Constant TX_PS_1168 = "A simple shovel, with a wooden handle and a metal blade.";
Constant TX_PS_875 = "A simple wooden rod, about a foot long, with a forked end.";
Constant TX_PS_869 = "A simple wooden table.";
Constant TX_PS_745 = "A simple wristwatch. The initials ~DM~ are engraved on the back.";
Constant TX_PS_1058 = "A single circuit breaker switch is mounted on the wall.";
Constant TX_PS_1144 = "A single window looks out over the front yard.";
Constant TX_PS_1148 = "A small bed sits in one corner. It's a rope bed, with a thin straw mattress.";
Constant TX_PS_1329 = "A small brass key.";
Constant TX_PS_1181 = "A small spotlight, designed to be hand-held. On the side is the branding ~Spectre~. The light has a short cord ending in a standard North American 120V AC plug.";
Constant TX_PS_1326 = "A small town, deserted. The buildings look from another era, but strangely still new.";
Constant TX_PS_1252 = "A small white key.";
Constant TX_PS_368 = "A small, flat device with a black button on it.";
Constant TX_PS_259 = "A small, plastic model of a TARDIS, a Rubik's cube, and a CMY cube are on the desk.";
Constant TX_PS_1082 = "A small, rusty, metallic, cylindrical object. One end is capped with a lens, while the other terminates in a threaded base, like that of a light bulb.";
Constant TX_PS_1176 = "A small, shiny, metallic, cylindrical object. One end is capped with a lens, while the other terminates in two shiny metal chains, each with a shiny metal clamp, as if it were designed to be attached to something.";
Constant TX_PS_576 = "A small, sturdy flashlight.";
Constant TX_PS_270 = "A soft, black pencil.";
Constant TX_PS_177 = "A spiraling staircase disappears into the ground here. It is made of the same gossamer, questionably real stuff as the ground, the pillar, and the compass. Faraji can't see past the first turn of the stairs, unfortunately.";
Constant TX_PS_1151 = "A staircase leads down.";
Constant TX_PS_826 = "A staircase leads up, probably to the roof.";
Constant TX_PS_1080 = "A standard 60W light bulb.";
Constant TX_PS_296 = "A standard numeric keypad. The font on the keys is really cool and science fictiony.";
Constant TX_PS_1923 = "A stone wall blocks the way.";
Constant TX_PS_1236 = "A strong institutional double door, painted a dark green. A sign on the door reads ~Public Gymnasium~.";
Constant TX_PS_994 = "A tall, steel lattice structure, rising prominently above the building. This kind of tower was designed to maximize height for better signal transmission and reception in the era before widespread cable and satellite technology. Strangely, the bars of the tower near roof-level are bent inward to form a small platform. It's almost as if something is meant to be mounted there.";
Constant TX_PS_1228 = "A threaded socket, like that of a light bulb, is mounted on one of the rods of the antenna.";
Constant TX_PS_3431 = "A time slip is a purported paranormal phenomenon in which a person, or group of people, travel through time via unknown means. The concept of time slips is often used in science fiction, but is also a popular topic in paranormal research. The most famous case of a time slip is the Moberly-Jourdain incident.";
Constant TX_PS_848 = "A tuning fork lies on the counter.";
Constant TX_PS_847 = "A tuning fork, used to tune musical instruments.";
Constant TX_PS_1650 = "A typical air register with a grill which one would hope would stop things like, say, a hex wrench from falling through. It's set in the floor behind the front desk. The vent is held closed by four screws.";
Constant TX_PS_828 = "A typical mid-twentieth-century lunch counter.";
Constant TX_PS_850 = "A typical store counter.";
Constant TX_PS_388 = "A ways off past the swamp, the highway carries most travelers right past this glum little village.";
Constant TX_PS_1022 = "A weight machine, designed to work the upper body.";
Constant TX_PS_1096 = "A weighty rutabaga.";
Constant TX_PS_379 = "A-plus laundromat";
Constant TX_PS_4030 = "ATTACH BATTERY TO WIRES";
