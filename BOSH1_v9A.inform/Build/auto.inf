Constant TX_PS_480 = "It's a big nectarine.";
Constant TX_PS_354 = "It's a bunch of cryptic scribbles.";
Constant TX_PS_1572 = "It's a bunch of trash. It's smelly and gross.";
Constant TX_PS_1558 = "It's a cheap blue flip phone, purchased by the Bureau as some kind of cost-saving measure. It's not even a smartphone. It's not even a good flip phone. It's not even a good bad flip phone. It's just a bad flip phone.";
Constant TX_PS_823 = "It's a diner without any food or furniture. So, just a room, really.";
Constant TX_PS_438 = "It's a handtruck, two wheels and a platform, used for moving heavy things.";
Constant TX_PS_522 = "It's a large key, probably for a door.";
Constant TX_PS_1986 = "It's a little cumbersome to carry around.";
Constant TX_PS_1073 = "It's a perfectly ordinary truck bed.";
Constant TX_PS_1562 = "It's a pretty nice phone, only a couple of years old, but Faraji doesn't have time to play with it. They need to get to the office.";
Constant TX_PS_1624 = "It's a pretty ordinary mass-produced desk, but Moira's re-stain job on it has truly transformed it. Really, is there anything she can't do?";
Constant TX_PS_1242 = "It's a red plastic thumb drive, with what look like symbols scratched on the surface, but they're like no symbols you've ever seen. The metal USB end is somewhat corroded.";
Constant TX_PS_1013 = "It's a regulation basketball court, with a shiny hardwood floor and a pair of hoops at either end. It's silent and empty.";
Constant TX_PS_1556 = "It's a small grey key, like the kind you might accidentally lock inside a desk drawer.";
Constant TX_PS_1669 = "It's a small keyhole in the front of the box.";
Constant TX_PS_1667 = "It's a small metal box affixed to the back wall of the closet. There is a small keyhole in the front.";
Constant TX_PS_245 = "It's a small, plastic model of a TARDIS.";
Constant TX_PS_542 = "It's a standard glow-in-the-dark light switch.";
Constant TX_PS_1661 = "It's a stylized skeleton, painted in neon hues. It's a bit macabre, but it's also a bit fun.";
Constant TX_PS_1626 = "It's a testament to Moira's competence and taste that she managed to acquire such a nice chair with the funds available.";
Constant TX_PS_429 = "It's a typical glass door. Taped to it is a sign that says ~Closed for renovations~.";
Constant TX_PS_444 = "It's a typical glass door. The light within is too dim to see much.";
