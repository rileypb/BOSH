    with p168_snarkable false
    with vector 0
    with door_dir [ 
        loc ! room of actor
        ;
        loc = location;
        if (loc == thedark) loc = real_location;
        if (loc == I1197_bosh_office_hallway) return I51_north; return I54_south;],
    with door_to [ 
        loc ! room of actor
