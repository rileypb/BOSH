    ParaContent(); print " ";! [14: look]
    ConjugateVerb_43(CV_POS, PNToVP(), story_tense); say__p=1; ! [15: ~, but there is nothing behind ~]
    ParaContent(); print ", but there is nothing behind ";! [16: the noun]
    ParaContent(); print (the) noun;! [17: ~.~]
