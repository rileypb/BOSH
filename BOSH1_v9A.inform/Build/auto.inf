Constant TX_PS_3943 = "Is it possible there are other astral tunnels Faraji hasn't found yet?";
Constant TX_PS_4034 = "Is it reminiscent of anything?";
Constant TX_PS_4079 = "Is there a passage that would be useful if it came true?";
Constant TX_PS_4069 = "Is there any place Faraji has seen names like that before?";
Constant TX_PS_3001 = "Is this about the Ark of the Covenant? It's a real thing, you know. The director of the movie was a Freemason. But it's important to note that the Ark cannot melt your face off. That's a myth.";
