! ----------------------------------------------------------------------------------------------------
! From "Swamp Park" by Philip Riley
! No specific request
! After printing the description of a dark room when the location is the back basement and in darkness:
[ R_1591 ;
    if (((((((real_location == I463_back_basement))) && (((location==thedark))))))) { ! Runs only while condition holds
    if (debug_rules) DB_Rule(R_1591, 1591);
