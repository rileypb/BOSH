Constant TX_PS_789 = "Lake Street by the park";
Constant TX_PS_794 = "Lake Street runs north and south from here. To the east is the public gymnasium, while to the west is the town hall, which is not enterable from here.";
Constant TX_PS_790 = "Lake Street runs north and south from here. To the west is the park, while to the east is the First Utilitarian Church of Enigma Lake.";
