Object I457_laundromat_back_door ""
    class K4_door
    with short_name BC_3546
    with description BC_3547
    with with_key I456_large_key
    has scenery
    has ~open
    has openable
    has lockable
    has locked
    with vector 0
    with door_dir [ 
        loc ! room of actor
        ;
        loc = location;
        if (loc == thedark) loc = real_location;
        if (loc == I440_back_lot) return I51_north; return I54_south;],
    with door_to [ 
        loc ! room of actor
        ;
        loc = location;
        if (loc == thedark) loc = real_location;
        if (loc == I440_back_lot) return I444_laundromat_back_room; return I440_back_lot;],
    with found_in I440_back_lot I444_laundromat_back_room
    has mark_as_thing
