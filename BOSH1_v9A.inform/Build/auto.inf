Constant TX_PS_2483 = "~Moira, what's the deal with the Confederacy?~";
Constant TX_PS_2490 = "~Moira, what's the deal with the Dyatlov Pass Incident?~";
Constant TX_PS_2475 = "~Moira, what's the deal with the Flatwoods Monster?~";
Constant TX_PS_2512 = "~Moira, what's the deal with the Freemasons?~";
Constant TX_PS_2516 = "~Moira, what's the deal with the Georgia Guidestones?~";
Constant TX_PS_2497 = "~Moira, what's the deal with the Holy Grail?~";
Constant TX_PS_2478 = "~Moira, what's the deal with the House of Representatives?~";
Constant TX_PS_2513 = "~Moira, what's the deal with the Knights Templar?~";
Constant TX_PS_2472 = "~Moira, what's the deal with the Moberly-Jourdain Incident?~";
Constant TX_PS_2505 = "~Moira, what's the deal with the New Order?~";
Constant TX_PS_2504 = "~Moira, what's the deal with the New World Order?~";
Constant TX_PS_2493 = "~Moira, what's the deal with the Philadelphia Experiment?~";
Constant TX_PS_2485 = "~Moira, what's the deal with the Phoenix Lights?~";
Constant TX_PS_2467 = "~Moira, what's the deal with the Roswell Incident?~";
Constant TX_PS_2477 = "~Moira, what's the deal with the Smithsonian Castle?~";
Constant TX_PS_2500 = "~Moira, what's the deal with the Spear of Destiny?~";
Constant TX_PS_2491 = "~Moira, what's the deal with the Ural Mountains?~";
Constant TX_PS_2495 = "~Moira, what's the deal with the Voynich Manuscript?~";
Constant TX_PS_2503 = "~Moira, what's the deal with the White House?~";
Constant TX_PS_2470 = "~Moira, what's the deal with the Yeti?~";
Constant TX_PS_2498 = "~Moira, what's the deal with time slips?~";
Constant TX_PS_2523 = "~Moira, what's the deal with vampires?~";
Constant TX_PS_2524 = "~Moira, what's the deal with werewolves?~";
Constant TX_PS_2525 = "~Moira, what's the deal with zombies?~";
Constant TX_PS_2499 = "~Moira, what's the story with the Ark of the Covenant?~";
Constant TX_PS_2486 = "~Moira, what's the story with the Betty-and-Barney Hill Abduction?~";
Constant TX_PS_2476 = "~Moira, what's the story with the Dover Demon?~";
Constant TX_PS_2502 = "~Moira, what's the story with the Illuminati?~";
Constant TX_PS_2479 = "~Moira, what's the story with the Kelly-Hopkinsville Encounter?~";
Constant TX_PS_2466 = "~Moira, what's the story with the Loch Ness Monster?~";
Constant TX_PS_2492 = "~Moira, what's the story with the Mary Celeste?~";
Constant TX_PS_2473 = "~Moira, what's the story with the Mothman?~";
Constant TX_PS_2484 = "~Moira, what's the story with the Rendlesham Forest Incident?~";
Constant TX_PS_2496 = "~Moira, what's the story with the Shroud of Turin?~";
Constant TX_PS_2489 = "~Moira, what's the story with the Tunguska Event?~";
Constant TX_PS_2537 = "~Moira, what's up with the Church of Scientology?~";
Constant TX_PS_2460 = "~Moira, what's your view on the Bureau?~";
Constant TX_PS_2563 = "~Moira, who was Groucho Marx?~";
Constant TX_PS_3243 = "~Money? No, no. Lost my wallet this morning in an automatic car wash. No, not that one out there. Another one. Long story. But go ask Margaret, see if there's anything in the petty cash drawer.~";
Constant TX_PS_3164 = "~Monkeys? They were a front organization for the Dave Clark Five. They were all robots. Except for Davy Jones. He was a vampire.~";
Constant TX_PS_2740 = "~Most people think he was from Kentucky. But he was from Indiana. He just liked the chicken in Kentucky better.~";
Constant TX_PS_2937 = "~My best-selling book in Iceland,~ Doctor Helpful replies.";
Constant TX_PS_2866 = "~My lucky numbers are 4, 8, 15, 16, 23, and 42.~";
Constant TX_PS_2841 = "~My sketchbook. Nothing you would understand. Don't look in it.~";
Constant TX_PS_2843 = "~My special drawing pencil. I'm not going to let you borrow it.~";
Constant TX_PS_930 = "~Name's Hutz. I'm the town groundskeeper. Or was, I guess. Not much to keep now.~";
Constant TX_PS_3051 = "~Natural History Museum? Great place, but why do they get to choose what's natural and what's not? Kind of presumptuous, if you ask me.~";
Constant TX_PS_3207 = "~Neil Patrick Harris is an American actor, comedian, writer, producer, and magician. He is best known for his roles in the television series ~Doogie Howser, M.D.~ and ~How I Met Your Mother.~ There is no scientific evidence to support the idea that he is a vampire.~";
Constant TX_PS_3231 = "~Nesmith? He was assassinated by the Dave Clark Five and replaced by a lizard person. The lizard person had to wear the hat to cover up its cranial ridges.~";
Constant TX_PS_2879 = "~Never been there. My mom does my clothes.~";
Constant TX_PS_2874 = "~Never heard of it. What are you guys doing in a dump like this?~";
Constant TX_PS_2724 = "~Never mind that, Agent. It's enough to know to stay away from it. It's a bad place.~";
Constant TX_PS_3120 = "~New Order is a British rock band that was formed in 1980. They are known for their electronic dance music and their hit song ~Blue Monday.~ There is no scientific evidence to support any supernatural explanation for their music.~";
Constant TX_PS_3006 = "~New Order? You're into them, eighties music, right? No, no, you were going to ask about the New World Order, weren't you? It's a real thing. It's a real thing, and it's a real threat. It's a real threat to the world. It's a real threat to the universe. Well, that's an exaggeration. But it's real bad.~";
Constant TX_PS_3052 = "~New York? Yes, of course. I assume you're talking about the one in Illinois. I've been there. It's a nice place. But you were probably talking about the one in New York, weren't you? I've been there, too. It's a nice place. But not as nice as the one in Illinois.~";
Constant TX_PS_2132 = "~Nice desk.~";
Constant TX_PS_3146 = "~Nikola Tesla was a Serbian-American inventor, electrical engineer, mechanical engineer, and futurist who is best known for his contributions to the design of the modern alternating current electricity supply system. There is no scientific evidence to support the idea that he was an alien.~";
Constant TX_PS_2860 = "~No need to get personal, man.~";
Constant TX_PS_2816 = "~No one ever believes me, but I tell you, he once shot Ed Meese in a fit of pique. I just hied myself back to hyperspace and let them sort it out.~";
Constant TX_PS_2747 = "~No one knows what caused it, but we do know that it wasn't the Black Knight Satellite. I know that may come as a shock.~";
Constant TX_PS_2941 = "~No one really knows where those places are. It used to mostly show a large underground labyrinth, filled with tunnels, caves, and peculiar rock formations, and every so often a bedraggled adventurer,~ Doctor Helpful replies.";
Constant TX_PS_303 = "~No, I don't have a screwdriver. Do I look like I do?~";
Constant TX_PS_3245 = "~No, I gave all my money to a vagrant this morning as I walked the 5 miles to work. I'm sure he needed it more than I did.~";
Constant TX_PS_2701 = "~No, I read non-fiction. That book is a documentary.~";
Constant TX_PS_2862 = "~No, I've never had sex on the counter, if that's what you're asking.~";
Constant TX_PS_2711 = "~No, it's not a TARDIS. It's a police box.~";
Constant TX_PS_3068 = "~No, no, I don't. I'm sorry. I don't know what to do. I'm sorry.~";
Constant TX_PS_928 = "~No, not anymore. Got angry and threw mine in the lake one day.~";
Constant TX_PS_3244 = "~No, nothing in there. But I have a few bucks in my purse. I left my purse in the car this morning when my boyfriend dropped me off. Can you wait until tomorrow?~";
Constant TX_PS_2951 = "~No, you're fine,~ Moira says. ~You just need a break.~";
Constant TX_PS_234 = "~No.~";
Constant TX_PS_2697 = "~None of your business.~";
Constant TX_PS_981 = "~Norbert the Narwhal, swimming in the sea, Norbert the Narwhal, happy as can be.~";
Constant TX_PS_2936 = "~Not my best work, but it has its moments,~ Doctor Helpful replies.";
Constant TX_PS_2734 = "~Not really a demon, as a matter of fact. He's just a little guy with big eyes. He's a good friend of mine.~";
Constant TX_PS_942 = "~Now, you've had your coffee. Can you help me?~ Faraji asks.";
Constant TX_PS_2799 = "~Of course. I've been everywhere. Hyperspace has a lot of tentacles.~";
Constant TX_PS_2968 = "~Oh please, the Bermuda Triangle is a hoax. It's just a place where ships and planes go down. It's not like it's a portal to another dimension. That's the Sargasso Sea.~";
Constant TX_PS_940 = "~Oh yes, how was I going to help? Afraid I can't remember, sorry. Can't seem to focus. I'm just so tired. Maybe if I had a cup of coffee, I could help you. But make sure it's hot -- hot enough to burn my tongue. I can't drink cold coffee, you know.~";
Constant TX_PS_2978 = "~Oh yes, the Flatwoods Monster. It's not even a cryptid. It's a robot from the CIA. I've seen the evidence.~";
Constant TX_PS_3072 = "~Oh, Budapest. It used to be two cities, you know. Buddha and Pesto. I love pesto. I can't remember what Buddha is. But I love pesto.~";
Constant TX_PS_2893 = "~Oh, I don't worry myself with that. I don't really know what you all do. I just know I love all of you.~";
Constant TX_PS_360 = "~Oh, I'm sorry, I don't have a screwdriver. Do you?~";
Constant TX_PS_2714 = "~Oh, just some notes. Nothing important. Just the fate of the world.~";
Constant TX_PS_3160 = "~Oh, the Beatles. They weren't as good as the Monkees. The Monkees had their own TV show.~";
Constant TX_PS_1112 = "~Oh, this old thing?~ Daniels says. ~You caught me. I borrowed it and never gave it back. Can you return it for me?~ He takes off the watch and hands it to you.";
Constant TX_PS_2726 = "~Oh, you know. A weather balloon. Or a spaceship. Or a weather balloon with a spaceship inside. It's all the same to me.~";
Constant TX_PS_2718 = "~Oh, you know. The usual. A little too much wine, a little too much time travel. But what's a little temporal paradox between friends?~";
Constant TX_PS_2800 = "~Once, in 1978. We were both in traffic court. I was there on some trumped-up charge about going left on a red light. Can you imagine?~";
Constant TX_PS_2719 = "~Only before it was one city. Pest was a nice place. Buda was a little snooty.~";
Constant TX_PS_3184 = "~Ooh, I know this one. He was the guy who invented the New Deal. Don't ask me what that was, though.~";
Constant TX_PS_2774 = "~Oops. That was me.~";
Constant TX_PS_3154 = "~Ouija boards are flat boards that are marked with the letters of the alphabet, the numbers 0-9, and the words ~yes~ and ~no.~ They are used in seances to communicate with spirits. There is no scientific evidence to support claims that Ouija boards can commune with the dead.~";
Constant TX_PS_2922 = "~Our plans are our own,~ hisses the lizard person. ~You will not stop us.~";
Constant TX_PS_3268 = "~Pawn shop? Is there one around here? Haven't noticed.~";
Constant TX_PS_3241 = "~Pennsylvania is a state in the northeastern United States. It is known for its historic sites, its cultural institutions, and its natural beauty. There is no scientific evidence to support the idea that it is the home of the Monkees.~";
Constant TX_PS_3240 = "~Pennsylvania? Enough to tell you to stay away from it. They'll try to make you eat scrapple. And then they'll try to make you like it. It's a trap, I tell you.~";
Constant TX_PS_3249 = "~Peter Tork was an American musician and actor who was best known as a member of the Monkees. He was also a talented multi-instrumentalist and songwriter. There is no scientific evidence to support the idea that he was involved in a love triangle with Yoko Ono and Marlo Thomas.~";
Constant TX_PS_2996 = "~Philadelphia Experiment? Was it even in Philadelphia? Is there even a Philadelphia? I'm still waiting for answers.~";
Constant TX_PS_2271 = "~Please, who is this Doogie Howser?~";
Constant TX_PS_3225 = "~Pompeii was an ancient Roman city that was destroyed by the eruption of Mount Vesuvius in 79 AD. It is one of the most famous archaeological sites in the world. There is no scientific evidence to support the idea that it was destroyed by the Freemasons.~";
Constant TX_PS_3209 = "~Reagan? He was a puppet of Neil Patrick Harris. And when Harris was through with him, he made him step down after two terms. But Reagan was a good sport about it. He went on to star in a movie with a monkey.~";
Constant TX_PS_2991 = "~Real? Yes, it's real. I mean, it's not a satellite, but it's real. You ever hear of the Tunguska Event? There's a connection, you know.~";
Constant TX_PS_3000 = "~Really happen? Yes, they do. The Moberly-Jourdain Incident for example, or -- well, I can't remember the other one. I was thinking about the Jersey Devil, and its connection to the Church of Scientology.~";
Constant TX_PS_2981 = "~Representatives? Bunch of fools. They don't know what's going on. They're too busy with their petty squabbles to see the real danger.~";
Constant TX_PS_3210 = "~Ronald Reagan was the 40th President of the United States. He served from 1981 to 1989 and was known for his conservative policies and his role in ending the Cold War. There is no scientific evidence to support the idea that he was a puppet of Neil Patrick Harris.~";
Constant TX_PS_3185 = "~Roosevelt? One of the greatest con jobs in American history. They tell us now that he was in a wheelchair. All to cover up the fact that he could fly. He stole Nikola Tesla's plans for a jetpack. That's why Truman killed him.~";
Constant TX_PS_2921 = "~Root vegetables?~ hisses the lizard person. ~We have no interest in root vegetables. Least of all rutabagas.~";
Constant TX_PS_2970 = "~Roswell? It's not what you think. It's not what anyone thinks. It's a cover-up, but not for what you think.~";
Constant TX_PS_3086 = "~Sacred geometry is a term used to describe the geometric patterns and shapes that are found in nature and in the universe. It is said to have spiritual significance and to represent the underlying order of the cosmos.~";
Constant TX_PS_3032 = "~Sargasso Sea? Yes. Well, no. But I know all about it. For one thing, it's not a sea. It's the surface of a huge alien jellyfish. I've seen the evidence.~";
Constant TX_PS_2964 = "~Savra -- that imbecile. He's a fool and a coward. He's the reason we're not prepared for the alien invasion.~";
Constant TX_PS_2911 = "~Savra, our great leader, will have the Dragon,~ hisses the lizard person.";
Constant TX_PS_1528 = "~Screwdriver you could borrow? No, no, someone stole my screwdriver collection. Probably the Illuminati.~";
Constant TX_PS_937 = "~Secret? What secret?~ Faraji asks.";
Constant TX_PS_338 = "~Senator Savra? What does he have to with anything?~ Faraji asks.";
Constant TX_PS_2687 = "~She occupies the reception desk well.~";
Constant TX_PS_2752 = "~She was a pilot. She was a good friend of mine. Shame what happened to her. Ah, but I can't talk about that.~";
Constant TX_PS_3262 = "~She was the girl who was lost in the woods and raised by wolves, right?~";
Constant TX_PS_3253 = "~She was the one who broke up the Monkees, right?~";
Constant TX_PS_2961 = "~She'll do,~ Moira says. ~She's a bit too eager, but she'll do.~";
Constant TX_PS_3238 = "~Siberia is a vast region in Russia that is known for its extreme cold, its vast forests, and its mineral resources. There is no scientific evidence to support the idea that it is the home of Budapest.~";
Constant TX_PS_3237 = "~Siberia? Not much. But enough to know that when the lizard people take over, that's where I'm going to hide. Those cold-blooded bastards will never find me there.~";
Constant TX_PS_2415 = "~So what about Geor --~";
Constant TX_PS_2385 = "~So what do you know about Jeffers--~";
Constant TX_PS_2369 = "~So what is Savra --~";
Constant TX_PS_2286 = "~So you know Klimp?~ Faraji asks.";
Constant TX_PS_2157 = "~So you read fiction too?~";
Constant TX_PS_2292 = "~So you're an artist?~";
Constant TX_PS_2779 = "~Some of my best friends are ghosts. Well, I mean, now they are. Why do people keep coming back to haunt me?~";
Constant TX_PS_2742 = "~Some people call it the biggest cover-up in the history of Rendlesham Forest. Some guys saw some stuff in the forest. That's all I know.~";
Constant TX_PS_3178 = "~Sometimes I think you ask me these questions just to see if I'm paying attention.~";
Constant TX_PS_2680 = "~Sometimes, yes -- the Bureau of Space and Hyperspace. Or is it Bureaucratic Office of Supernatural History? Or Business Office for Standard Howitzers? Or Big Office of the Slightly Hilarious? Oh yes, Bureau of Strange Happenings. But I like to think of it as the Baby of Stan and Harriet.~";
Constant TX_PS_1674 = "~Sorry, I don't have a screwdriver. You might try the Chief.~";
Constant TX_PS_3145 = "~Spontaneous human combustion is the alleged phenomenon in which a person catches fire and burns to death without an external source of ignition. There is no scientific evidence to support the claims of spontaneous human combustion.~";
Constant TX_PS_3214 = "~Stop harrassing me about my personal life.~";
Constant TX_PS_3276 = "~Stop talking to Klimp.~";
Constant TX_PS_2848 = "~Stuff.~";
Constant TX_PS_3227 = "~Sumeria was an ancient civilization that was located in Mesopotamia. It is considered one of the earliest known civilizations in the world. There is no scientific evidence to support the idea that it had advanced technology or contact with extraterrestrial beings.~";
Constant TX_PS_3229 = "~Sumeria? Most people think of them as an ancient middle eastern civilization. But new evidence suggests that they emigrated there from Kamchatka.~";
Constant TX_PS_588 = "~Sure I do -- I put it in your desk.~ She furrows her brow. ~What's the matter?~";
Constant TX_PS_1536 = "~Sure! Why don't you scout the locality for astral phenomena?~";
Constant TX_PS_2950 = "~Sure, Faraji,~ Klimp says, ~but have you seen this article about the Piltdown Man?~";
Constant TX_PS_3143 = "~Telekinesis is the ability to move objects with the mind. It is considered a pseudoscience by the scientific community. There is no scientific evidence to support the claims of telekinesis.~";
Constant TX_PS_2785 = "~Telekinetics is a form of exercise. It's very good for the core. I do it every morning.~";
Constant TX_PS_3144 = "~Teleportation is the theoretical transfer of matter or energy from one point to another without traversing the physical space between them. It is considered a pseudoscience by the scientific community. There is no scientific evidence to support the claims of teleportation.~";
Constant TX_PS_3028 = "~Television? Well, of course I do. I used to watch it all the time. Especially ESPN. For the passion. For the irrelevant discussions. For the games. But I don't think that's what you meant. You meant telekinesis, didn't you? I can't remember what I think about that.~";
Constant TX_PS_2320 = "~Tell me about Enigma Lake,~ Faraji asks.";
Constant TX_PS_2152 = "~Tell me about the coffee maker.~";
Constant TX_PS_2244 = "~Tell me about the huge alien jellyfish.~";
Constant TX_PS_2312 = "~Tell me about your clothes.~";
Constant TX_PS_2812 = "~Terrible time. Half of the hobos were out-of-work lizard people. I went to work as a train mechanic to keep an eye on them.~";
Constant TX_PS_3031 = "~Tesla? He was a time traveler. I've seen the evidence. He went back in time to save the crew of the Mary Celeste. He died as a result of the Philadelphia Experiment. It's all connected.~";
Constant TX_PS_2928 = "~Thank you, Larch. It's lovely,~ Doctor Helpful replies.";
Constant TX_PS_2926 = "~Thank you, but I'm afraid I'm not much of a gardener. Feel free to PICK FLOWER if you like,~ Doctor Helpful replies.";
Constant TX_PS_2672 = "~Thank you. It's a desk.~";
Constant TX_PS_2695 = "~Thank you. You have good taste.~";
Constant TX_PS_2938 = "~That one was a real labor of love. I'm quite proud of it,~ Doctor Helpful replies.";
Constant TX_PS_3264 = "~That was the little blue train that could, right?~";
Constant TX_PS_2686 = "~That was the lobby. I helped design it.~";
Constant TX_PS_2929 = "~That's a nice umbrella,~ Doctor Helpful replies.";
Constant TX_PS_3046 = "~That's my thinking chair. It's beautiful, don't you think?~ I got it at an auction by the Church of Scientology. They have the best auctions. I once got a book about hypnosis at one of their auctions. Good book.~";
Constant TX_PS_2794 = "~That's the governing body of OUIJA. By the way, OUIJA stands for ~Organization of Unusual Interdimensional Journeys and Adventures.~~";
Constant TX_PS_2895 = "~That's the only thing left of my old friend Josef,~ Hutz replies.";
Constant TX_PS_3221 = "~The American Museum of Natural History is a museum in New York City that is dedicated to the study of natural history. It is one of the largest and most celebrated museums of its kind in the world. There is no scientific evidence to support the idea that it is a front for the Illuminati.~";
Constant TX_PS_3114 = "~The Ark of the Covenant is a sacred chest that is said to have contained the tablets of the Ten Commandments. It is believed by some to possess supernatural powers. There is no scientific evidence to support this claim.~";
Constant TX_PS_3162 = "~The Beatles were a British rock band that was formed in Liverpool in 1960. They are one of the most commercially successful and critically acclaimed bands in the history of popular music. There is no scientific evidence to support the idea that they were a front for the Illuminati.~";
Constant TX_PS_2373 = "~The Ber--~";
Constant TX_PS_3101 = "~The Betty and Barney Hill Abduction is a case of alleged alien abduction that occurred in New Hampshire in 1961. The Hills claimed to have been taken aboard a UFO and subjected to medical examinations. There is no scientific evidence to support their claims.~";
Constant TX_PS_3103 = "~The Black Knight Satellite is a mysterious object that is said to orbit the Earth. It is said to be an alien spacecraft or a piece of space debris. There is no scientific evidence to support its existence.~";
Constant TX_PS_3266 = "~The Bugbear of Slocum Heath is totally made up. Seriously. It's just got the right initials. BOSH. That's all it is. There is no scientific evidence to support the idea that it is a real creature.~";
Constant TX_PS_2963 = "~The Bureau will be the most important line of defense when the alien threat inevitably comes to fruition. Savra is a fool,~ he says with a gleam in his eye.";
Constant TX_PS_3205 = "~The Chief tells me he's a vampire. But I think he's just an astronaut.~";
Constant TX_PS_3152 = "~The Church of Scientology is a controversial new religious movement that was founded by science fiction writer L. Ron Hubbard in the 1950s. There is no scientific evidence to support the claims of Scientology.~";
Constant TX_PS_3098 = "~The Confederacy was a group of states that seceded from the United States in 1861. They were defeated in the American Civil War. They never had anything to do with the Black Knight Satellite.~";
Constant TX_PS_3174 = "~The Dave Clark Five were a British rock band that was formed in London in 1958. They were one of the leading bands of the British Invasion of the United States in the 1960s. There is no scientific evidence to support the idea that the Monkees were a front through which they pushed their Marxist agenda.~";
Constant TX_PS_3091 = "~The Dover Demon is a creature that is said to have been sighted in Dover, Massachusetts in 1977. It is said to be a small, humanoid creature with glowing eyes and a large, egg-shaped head. There is no scientific evidence to support the existence of such a creature.~";
Constant TX_PS_1124 = "~The Dragon is the last, best hope for humanity and lizard people alike. He is the one who will bring peace between our two peoples. I was sent back in time by Savra's minions when I discovered their secret plan to kill him.~";
Constant TX_PS_3105 = "~The Dyatlov Pass Incident is a case of alleged hikers~ deaths that occurred in the Ural Mountains in 1959. Nine experienced hikers died under mysterious circumstances. There is no scientific evidence to support any supernatural explanation.~";
Constant TX_PS_3090 = "~The Flatwoods Monster is a creature that is said to have been sighted in Flatwoods, West Virginia in 1952. It is said to be a large, humanoid creature with glowing eyes and a spade-shaped head. There is no scientific evidence to support the existence of such a creature.~";
Constant TX_PS_3127 = "~The Freemasons are a fraternal organization that traces its origins to the local fraternities of stonemasons, which from the end of the fourteenth century regulated the qualifications of masons and their interaction with authorities and clients. There is no scientific evidence to support the idea that they are a secret society that controls world events.~";
Constant TX_PS_3131 = "~The Georgia Guidestones are a granite monument that is located in Elbert County, Georgia. They are inscribed with ten guidelines in eight modern languages and a shorter message in four ancient languages. There is no scientific evidence to support any supernatural explanation for them.~";
Constant TX_PS_3198 = "~The Great Depression was a severe worldwide economic depression that lasted from 1929 to the late 1930s. It was the longest, deepest, and most widespread depression of the 20th century. There is no scientific evidence to support the idea that it was caused by lizard people.~";
Constant TX_PS_2912 = "~The Greatest of All, corrupted by the surface vermin,~ hisses the lizard person.";
Constant TX_PS_3112 = "~The Holy Grail is a mythical cup that is said to have been used by Jesus Christ at the Last Supper. It is believed by some to possess magical powers. There is no scientific evidence to support this claim.~";
Constant TX_PS_3093 = "~The House of Representatives is one of the two chambers of the United States Congress. It is made up of 435 members who represent the people of the United States. Has Klimp been talking politics again?~";
Constant TX_PS_3117 = "~The Illuminati is a secret society that is said to control world events and manipulate governments. There is no scientific evidence to support the existence of the Illuminati.~";
Constant TX_PS_3089 = "~The Jersey Devil is a creature that is said to inhabit the Pine Barrens of New Jersey. It is said to be a winged creature with hooves and a forked tail. This one is real.~";
Constant TX_PS_3094 = "~The Kelly-Hopkinsville Encounter is a case of alleged alien visitation that occurred in Kelly, Kentucky in 1955. A family claimed to have been attacked by small, silver beings with large eyes. There is no scientific evidence to support their claims.~";
Constant TX_PS_3128 = "~The Knights Templar were a medieval Christian military order that was active from the 12th to the 14th centuries. They were one of the most powerful and wealthy organizations in the Middle Ages. There is no scientific evidence to support the idea that they possessed the Holy Grail.~";
Constant TX_PS_3149 = "~The Marfa Lights are mysterious lights that are said to appear near Marfa, Texas. They are a popular subject in folklore, and there is no scientific evidence to support any supernatural explanation for them.~";
Constant TX_PS_3183 = "~The Marx Brothers were an American family comedy act that was popular in vaudeville, on Broadway, and in motion pictures. The brothers were Groucho, Chico, Harpo, Gummo, and Zeppo. There is no scientific evidence to support the idea that they conspired to throw the 1932 election to FDR.~";
Constant TX_PS_3107 = "~The Mary Celeste was a ship that was found adrift in the Atlantic Ocean in 1872. The crew was missing, and the ship was in good condition. There is no scientific evidence to support any supernatural explanation.~";
Constant TX_PS_3087 = "~The Moberly-Jourdain Incident is a case of time slip that occurred in France in 1901. Two women, Charlotte Anne Moberly and Eleanor Jourdain, claimed to have traveled back in time to the 18th century while visiting the Palace of Versailles. There is no scientific evidence to support their claims.~";
Constant TX_PS_3165 = "~The Monkees were an American rock band that was formed in Los Angeles in 1966. They were created for a television show of the same name. There is no scientific evidence to support the idea that they were a front for the Dave Clark Five.~";
Constant TX_PS_3088 = "~The Mothman is a creature that is said to inhabit the area around Point Pleasant, West Virginia. It is said to be a large, winged creature with glowing red eyes. There have been numerous sightings of the Mothman, but there is no scientific evidence to support the existence of such a creature.~";
Constant TX_PS_2704 = "~The Mothman is a cryptid that was sighted in West Virginia in the 1960s. Friend of mine. Good guy. I met him on Spruce Knob outside of Judy Gap. He's a bit of a recluse, but he plays a mean game of pinochle.~";
Constant TX_PS_2832 = "~The Mothman is a cryptid that was sighted in West Virginia in the 1960s. I think he's a friend of Doris's. I've never met him.~";
Constant TX_PS_3119 = "~The New World Order is a conspiracy theory that posits the existence of a secret cabal that seeks to establish a totalitarian world government. There is no scientific evidence to support the existence of the New World Order.~";
Constant TX_PS_3279 = "~The Onondaga are a Native American tribe that is part of the Iroquois Confederacy. They are known for their contributions to the culture and history of the region. There is no scientific evidence to support the idea that they discovered the secret of time travel.~";
Constant TX_PS_3108 = "~The Philadelphia Experiment is a case of alleged time travel that occurred in Philadelphia in 1943. The USS Eldridge was said to have been rendered invisible and teleported. There is no scientific evidence to support any supernatural explanation.~";
Constant TX_PS_2751 = "~The Philadelphia Experiment? Oh, that was a good one. I was there. I was the one who suggested they use a battleship. I'm very proud of that.~";
Constant TX_PS_3100 = "~The Phoenix Lights are a series of alleged UFO sightings that occurred in Phoenix, Arizona in 1997. Thousands of people claimed to have seen a large, V-shaped object in the sky. There is no scientific evidence to support their claims.~";
Constant TX_PS_3216 = "~The Piltdown Man was a hoax that was perpetrated in England in the early 20th century. It involved the discovery of a skull that was said to be the missing link between humans and apes. There is no scientific evidence to support the claims of the Piltdown Man.~";
Constant TX_PS_3171 = "~The Ramones were an American punk rock band that was formed in New York City in 1974. They are considered one of the first punk rock bands. There is no scientific evidence to support the idea that they were a Monkees cover band.~";
Constant TX_PS_3170 = "~The Ramones? Are they still around? Do people still talk about them? Say, why are we talking about pop music? We should be talking about alien abductions.~";
Constant TX_PS_3099 = "~The Rendlesham Forest Incident is a case of alleged UFO visitation that occurred in Rendlesham Forest, England in 1980. Several military personnel claimed to have seen a strange, triangular object in the forest. There is no scientific evidence to support their claims.~";
Constant TX_PS_3258 = "~The Romanov family was the last imperial dynasty to rule Russia. They were overthrown during the Russian Revolution in 1917 and were executed by the Bolsheviks in 1918. There is no scientific evidence to support the idea that they were a front for the Illuminati.~";
Constant TX_PS_3147 = "~The Sargasso Sea is a region in the North Atlantic Ocean that is bounded by four currents. It is known for its large seaweed mats and its calm, windless waters. Myths about it are just that.~";
Constant TX_PS_3084 = "~The Sasquatch is a mythical creature that is said to inhabit the forests of North America. It is said to be a large, hairy, ape-like creature. There is no scientific evidence to support the existence of such a creature.~";
Constant TX_PS_3111 = "~The Shroud of Turin is a linen cloth that is said to bear the image of a man who was crucified. It is believed by some to be the burial shroud of Jesus Christ. There is no scientific evidence to support this claim.~";
Constant TX_PS_3092 = "~The Smithsonian Castle is a building that houses the administrative offices of the Smithsonian Institution in Washington, D.C. It is a beautiful building with a rich history. Klimp believes some weird things about it.~";
Constant TX_PS_3115 = "~The Spear of Destiny is a legendary weapon that is said to have pierced the side of Jesus Christ during his crucifixion. It is believed by some to possess supernatural powers. There is no scientific evidence to support this claim.~";
Constant TX_PS_3002 = "~The Spear of Destiny, right? It's a real thing. I've seen it. It's in the Vatican. But it's a fake. The real one was stolen by the Illuminati.~";
Constant TX_PS_3104 = "~The Tunguska Event was a massive explosion that occurred in Siberia in 1908. It is believed to have been caused by the impact of a meteoroid or a comet. There is no scientific evidence to support any other explanation.~";
Constant TX_PS_3106 = "~The Ural Mountains are a mountain range that runs through western Russia. They are known for their rich mineral deposits and their scenic beauty. Despite Klimp's claims, they very much do exist.~";
Constant TX_PS_3226 = "~The Vatican is an independent city-state that is located within Rome, Italy. It is the spiritual and administrative center of the Roman Catholic Church. There is no scientific evidence to support the idea that it is a collective hallucination.~";
Constant TX_PS_3213 = "~The Vietnam War was a conflict that took place in Vietnam, Laos, and Cambodia from 1955 to 1975. It was fought between the United States and its allies and the Viet Cong and North Vietnam. There is no scientific evidence to support the idea that it was a front for the lizard people.~";
Constant TX_PS_3110 = "~The Voynich Manuscript is a mysterious book that is written in an unknown script and contains illustrations of plants, stars, and other objects. There is no scientific evidence to support any supernatural explanation for its origin.~";
Constant TX_PS_3118 = "~The White House is the official residence and workplace of the President of the United States. It is located in Washington, D.C. Don't believe anything Klimp says about it.~";
Constant TX_PS_2973 = "~The Yeti is a bear. I've seen the evidence. It's a bear. A bear from another world.~";
Constant TX_PS_3085 = "~The Yeti is a mythical creature that is said to inhabit the Himalayan mountains. It is said to be a large, hairy, ape-like creature. There is no scientific evidence to support the existence of such a creature.~";
Constant TX_PS_3083 = "~The chupacabra is a mythical creature that is said to inhabit parts of the Americas. It is said to be a blood-sucking creature that preys on livestock. There is no scientific evidence to support the existence of such a creature.~";
Constant TX_PS_3269 = "~The guy there is creepy.~";
Constant TX_PS_2143 = "~The lobby? You mean the infinite wasteland I was forced to wander through to get here?~";
Constant TX_PS_2819 = "~The most evil of the Monkees. He might have been a lizard person. I'm not sure.~";
Constant TX_PS_2750 = "~The most ghosty of all ghost ships. All the crew disappeared. I think they went to the Bahamas.~";
Constant TX_PS_2873 = "~The name gives it too much credit.~";
Constant TX_PS_2916 = "~The rutabaga means nothing,~ hisses the lizard person. ~We are certainly not afraid of it. No, definitely not. At all. Ever.~";
Constant TX_PS_2876 = "~The zombie apocalypse will start here.~";
Constant TX_PS_2917 = "~Then we will be happy, for turnips are our favorite food,~ hisses the lizard person.";
Constant TX_PS_2728 = "~There are a lot of them. They're all over the place. They're very good at hiding. I think they're in the Bureau.~";
Constant TX_PS_2771 = "~There are a lot of theories about them. But no one knew them like I did. We used to have some great times in the Holy Land.~";
Constant TX_PS_3148 = "~There's no such thing. But if there were, I'd be the first to know.~";
Constant TX_PS_2749 = "~There's quite a debate about whether they exist or not. I'm on the side of the people who think they do.~";
Constant TX_PS_3076 = "~There's something not right about him. I can't put my finger on it.~";
Constant TX_PS_2884 = "~They don't make a statement. They're just clothes.~";
Constant TX_PS_3259 = "~They were the ones who built the pyramids, right?~";
Constant TX_PS_2760 = "~They're a secret society. They're so secret even I don't know if I'm a member.~";
Constant TX_PS_2773 = "~They're a set of instructions for building a really big clock. I think they're in Georgia, the one in the United States.~";
Constant TX_PS_2824 = "~They're a tribe of Native Americans. From upstate New York. Daniels has been living with them in the 14th century.~";
Constant TX_PS_2831 = "~They're a tribe of Native Americans. From upstate New York. Klimp has some strange ideas about them.~";
Constant TX_PS_2793 = "~They're a way of getting around. I've got one in my garage. It's a little rusty, but -- oh wait, that's a Vespa scooter.~";
Constant TX_PS_2776 = "~They're a way of telling the aliens where to land. I've got a few in my backyard.~";
Constant TX_PS_2717 = "~They're astral lenses. They let you see things you wouldn't normally see. Like the truth. And penguins. Anyway, don't lose them.~";
Constant TX_PS_2756 = "~They're like time travel, but without the travel. You just slip from one time to another. It's a real pain.~";
Constant TX_PS_2770 = "~They're the ones who hold Colonel Sanders~ secret recipe. I'm not supposed to talk about it.~";
Constant TX_PS_2683 = "~This is the BOSH Hyperspace Field Office. This is where we are. Isn't that obvious?~";
Constant TX_PS_2703 = "~This, to my eternal regret, is the BOSH Hyperspace Field Office. It is to where I am eternally condemned. I mean, where I work.~";
Constant TX_PS_3125 = "~Thomas Edison was an American inventor and businessman who is best known for his development of the electric light bulb. He also invented the phonograph and the motion picture camera. There is no scientific evidence that he ever killed a yeti.~";
Constant TX_PS_3011 = "~Thomas Edison? Madman. Genius. Fraud. All of these things. He once killed a yeti with his bare hands.~";
Constant TX_PS_2868 = "~Those shelves were perfectly organized when I stocked them last month.~";
Constant TX_PS_3113 = "~Time slips are a phenomenon in which people claim to have traveled through time without any conscious effort. There is no scientific evidence to support the existence of time slips.~";
Constant TX_PS_2965 = "~Time travel is a fact,~ Klimp says. ~Tesla had a time machine. I've seen it.~";
Constant TX_PS_3201 = "~Tracy Chapman is an American singer-songwriter who is best known for her hit song ~Fast Car.~ There is no scientific evidence to support the idea that she is a time traveler.~";
Constant TX_PS_3048 = "~Travels in Time? I've read it. It's a good book. Did you know it hasn't even been written yet? True story. Strangely, Debi Bosworth was killed in the Dyatlov Pass Incident. I've seen the evidence.~";
Constant TX_PS_3188 = "~Truman? Most people don't know that he was a lizard person. He was the one who killed FDR. And the worst part is, he didn't even eat him. He just did it for fun.~";
Constant TX_PS_2999 = "~Turin? It's really a map. I've seen the evidence. It's a map. A map to the Black Knight Satellite.~";
Constant TX_PS_3153 = "~UFOs, or unidentified flying objects, are objects in the sky that are not readily identifiable. There is no scientific evidence to support the idea that they are of extraterrestrial origin.~";
Constant TX_PS_3038 = "~UFOs? Yes, I do. I've seen them. I've been in them. I've talked to the pilots. I've been a pilot. I've been a UFO. I think. I can't remember.~";
Constant TX_PS_2780 = "~Ugh. Them and their nasty, big, pointy teeth. I don't like them. They have no respect for personal space.~";
Constant TX_PS_2899 = "~Uh, yeah, of course I am. I'm leaving tomorrow morning,~ Hutz replies.";
Constant TX_PS_1115 = "~Um, yeah,~ Daniels says. ~I'm afraid I misplaced it.~";
Constant TX_PS_2761 = "~Um. White. House. It's a house that's white. I think it's in Washington.~";
Constant TX_PS_2994 = "~Ural Mountains don't exist? Of course they don't. And that's a problem, because nothing else is keeping Europe and Asia apart.~";
Constant TX_PS_3138 = "~Vampires are mythical creatures that are said to feed on the blood of the living. They are a popular subject in folklore, literature, and popular culture. There is no scientific evidence to support the existence of vampires.~";
Constant TX_PS_3056 = "~Vatican? Don't be fooled by the funny hats. They're planning an invasion of the Black Knight Satellite. I've seen the evidence.~";
Constant TX_PS_2934 = "~Verbs are the flashy ones -- they get all the attention. Every work of interactive fiction has its own set of verbs, most of which are standard across games, but some of which are unique. For instance, a game about a chef might have a verb like COOK, while a game about a detective might have a verb like INTERROGATE,~ Doctor Helpful replies.";
Constant TX_PS_2804 = "~Vicious, vicious people. They once poked my eye out with a drumstick. I got better.~";
Constant TX_PS_3024 = "~Violins? Violets? Violence? Finish your words, Faraji. I can't read your mind. Oh, wait, you were going to ask about vampires, weren't you? They're sometimes real. Sometimes not. It's a quantum thing.~";
Constant TX_PS_3150 = "~Vladimir Ilyich Ulyanov, better known by the alias Lenin, was a Russian revolutionary, politician, and political theorist. He served as the head of government of Soviet Russia from 1917 to 1924 and of the Soviet Union from 1922 to 1924. There is no scientific evidence to support the idea that he was a vampire.~";
Constant TX_PS_3212 = "~War? I don't want to wade into that quagmire. But I will say this: the Monkees had the right of it from the beginning. They knew that the war was a front for the lizard people.~";
Constant TX_PS_2910 = "~We are here to stop you. We will have the Dragon,~ hisses the lizard person.";
Constant TX_PS_3075 = "~We do important work, when Klimp lets us. And when they're not cutting our budget. Why it was only last week we caught those corrupt old men trying to cheat the old lady out of her house by pretending to be ghosts.~";
Constant TX_PS_2918 = "~We fear no potato,~ hisses the lizard person. ~It is a weak weapon.~";
Constant TX_PS_2787 = "~We need to ask, is it really spontaneous? Perhaps the victims have been planning it for years. How would we know?~";
Constant TX_PS_2914 = "~We want nothing with you,~ hisses the lizard person. ~You are nothing to us.~";
Constant TX_PS_2945 = "~We're here to help you, Agent Faraji. That's what we do,~ Doctor Helpful replies.";
Constant TX_PS_1121 = "~We're in an old Onondaga root cellar in upstate New York. Well not so old now, I guess. I've managed to make friends with the locals well enough, so they let me sleep in here.~";
Constant TX_PS_938 = "~Well, *I* don't know. Just kinda thought you must be searching for some kind of mystical secret, seeing that you're wandering like a fool through a town about to be flooded. But I can help you, yep.~";
Constant TX_PS_3070 = "~Well, I only know what Klimp has told me. Better ask him.~";
Constant TX_PS_2955 = "~Well, I've only known her a few weeks,~ Margaret says, ~but she seems really smart.~";
Constant TX_PS_2822 = "~Well, in a manner of speaking. I certainly talked in his vicinity.~";
Constant TX_PS_3071 = "~Well, not a lot, but I hear it's full of Turkeys. And not the kind you eat. The kind that are really big and can fly. I think. I can't remember.~";
Constant TX_PS_490 = "~Well, that's a tricky one. Laundromat's been closed for almost two weeks now, since the owner just split for some reason he didn't bother to share. Not likely to get ahold of him. If you're not averse to a little trespassing, though, see if you come across a watch. Another thing he borrowed.~";
Constant TX_PS_2808 = "~Well, there were a good many of them: Groucho, Harpo, Chico, Zeppo, Gummo, Dumbo, Gumbo, and Harpo II. They were all working for the Bureau at one time or another.~";
Constant TX_PS_3082 = "~Well, we really don't know what happened there. Certainly aliens exist somewhere in the universe, but I find it farfetched that they could visit other star systems.";
Constant TX_PS_325 = "~Well, you'll just have to go back and get it, won't you? We can't be fooling around when the fate of the timeline is at stake!~ Doris says.";
Constant TX_PS_3139 = "~Werewolves are mythical creatures that are said to transform from human to wolf form. They are a popular subject in folklore, literature, and popular culture. There is no scientific evidence to support the existence of werewolves.~";
Constant TX_PS_2821 = "~What I want to know is, where's the unnatural history museum? That's what I'd like to visit.~";
Constant TX_PS_2386 = "~What about Colonel --~";
Constant TX_PS_2175 = "~What about Senator Savra?~";
Constant TX_PS_2220 = "~What are Leyden jars?~";
Constant TX_PS_2249 = "~What are UFOs?~";
Constant TX_PS_2167 = "~What are all these papers?~";
Constant TX_PS_2168 = "~What are all these things on your desk?~";
Constant TX_PS_2228 = "~What are ancient astronauts?~";
Constant TX_PS_2230 = "~What are crop circles?~";
Constant TX_PS_2218 = "~What are crystals?~";
Constant TX_PS_2233 = "~What are ghosts?~";
