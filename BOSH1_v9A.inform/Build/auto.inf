    ParaContent(); 
    	jump L_SayX2451; .L_Say2531; if (~~(((((Adj_113_t1_v10(I668_metal_cabinet))))))) jump L_Say2532;! [13: ~, closed~]
    ParaContent(); print ", closed";! [14: otherwise]

    	jump L_SayX2451; .L_Say2532;! [15: ~, hanging open. Inside it is a power switch~]
    ParaContent(); print ", hanging open. Inside it is a power switch";! [16: end if]

    	.L_Say2533; .L_SayX2451;! [17: ~.~]
