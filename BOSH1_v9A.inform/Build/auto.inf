Constant TX_PS_692 = "George Bestington";
Constant TX_PS_693 = "George Bestington's new book is a must-read for anyone who's ever thought ~I'm too skeptical.~ A guide to the benefits of believing in things that are obviously not true.";
Constant TX_PS_1693 = "Georgia Guidestones";
Constant TX_PS_3449 = "Ghosts are the spirits of the dead that haunt the living. They are often said to be the souls of people who have died in violent or tragic circumstances, and are often said to be the spirits of people who have unfinished business on Earth. Ghosts are often said to be the cause of unexplained phenomena, such as cold spots, strange noises, and objects moving by themselves. The existence of ghosts is disputed by the scientific community, but has been proven by numerous eyewitness accounts and photographs.";
