        ParaContent(); print "There is a strange blue-white glow emanating from behind some large dark objects."; new_line; .L_Say966; .L_SayX933;} else {
        ! [17: say ~A washing machine is revealed in the darkness by the glow emanating from its drum[if the broken washing machine is open]. The door is open[otherwise]. The door is closed[end if].~]
        say__p=1;! [18: ~A washing machine is revealed in the darkness by the glow emanating from its drum~]
