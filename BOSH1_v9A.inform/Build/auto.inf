Constant TX_PS_217 = "Minerva's papers";
Constant TX_PS_214 = "Minerva, a field agent, is sitting at her desk, typing away on her computer. She is dressed very professionally in a white blouse and black slacks.";
Constant TX_PS_3343 = "Minerva, lost in thought, looks up. ~Don't drink too much coffee. I pay for it, you know.~";
