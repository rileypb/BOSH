    	if (~~(((((Adj_123_t1_v10(I671_power_switch))))))) jump L_Say2530;! [5: ~, humming loudly,~]
    ParaContent(); print ", humming loudly,";! [6: end if]

    	.L_Say2530; .L_SayX2450;! [7: ~ rises many feet above ~]
    ParaContent(); print " rises many feet above ";! [8: us]
    ParaContent(); (PHR_767_r54 ());! [9: ~. The exit is down. A metal cabinet is attached to the foot of the tower~]
    ParaContent(); print ". The exit is down. A metal cabinet is attached to the foot of the tower";! [10: if the metal cabinet is locked]

    	if (~~(((((Adj_117_t1_v10(I668_metal_cabinet))))))) jump L_Say2531;! [11: ~, held shut by a padlock~]
