Constant TX_PS_2429 = "~Chief, what's the story on the Marfa --~";
Constant TX_PS_2395 = "~Chief, what's the story with the Mary --~";
Constant TX_PS_2388 = "~Chief, what's the story with the Rendlesham --~";
Constant TX_PS_2382 = "~Chief, what's the story with the Smithsonian --~";
Constant TX_PS_2440 = "~Chief, what's the story with your side table --~";
