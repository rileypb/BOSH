Constant TX_PS_2331 = "~What do you know about Senator Savra?~ asks Faraji.";
Constant TX_PS_2280 = "~What do you know about Sumeria?~";
Constant TX_PS_2140 = "~What do you know about this?~";
Constant TX_PS_2327 = "~What do you like about the Dragnet theme song?~ Faraji asks.";
