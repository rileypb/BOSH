Verb 'compare'
    * scope=Scope_Filter_172 'to' scope=Scope_Filter_173  -> A214_subject_comparing
;
Verb 'q-available'
    * scope=Scope_Filter_174  -> A215_quip_querying
;
Verb 'purge'
    *  -> A216_purging
;





#IFTRUE (1 == 1);
[ UnknownVerb; verb_wordnum = 0; return 'no.verb'; ];
[ PrintVerb v;
	if (v == 'no.verb') { print "do something to"; rtrue; }
	rfalse;
];
#Ifnot;
[ UnknownVerb; rfalse; ]; [ PrintVerb v; rfalse; ];
#ENDIF;


! ==== ==== ==== ==== ==== ==== ==== ==== ==== ====
! Output.i6t: Deferred Propositions
! ==== ==== ==== ==== ==== ==== ==== ==== ==== ====







