    if ((( (actor==player) && ((noun ofclass K2_thing)) && (self=actor,true) && (((((Prop_150())))) && ((( BlkValueCompare(GProperty(OBJECT_TY, noun,p23_behind_description), EMPTY_TEXT_VALUE) == 0))))))) { ! Runs only when pattern matches
