Constant TX_PS_769 = "Solvay Road 100 block";
Constant TX_PS_774 = "Solvay Road bends here, leading northwest out of town and south back into town. East is the park, and to the west is Horton House. One can walk down to the lake shore to the north.";
Constant TX_PS_877 = "Solvay Road by the lake";
Constant TX_PS_893 = "Solvay Road is west of here.";
Constant TX_PS_773 = "Solvay Road leading out of town";
Constant TX_PS_878 = "Solvay Road runs by the lake shore here. It continues out of town to the northwest, while to the southeast it leads back into town. A dirty shack stands opposite the lake to the west. A path along the shore leads to the east.";
Constant TX_PS_892 = "Solvay Road";
Constant TX_PS_770 = "Solvay heads north and south. To the west is the fire station, while to the east is the side of the town hall.";
Constant TX_PS_1254 = "Some cardboard boxes that have been broken down flat for recycling.";
Constant TX_PS_1243 = "Some crazy dude mailed this to me last month, said he found it in an ancient Onondaga root cellar on a farm in upstate New York. Claimed it was proof of time travel.";
Constant TX_PS_1006 = "Some kind of record book sits on the front desk.";
Constant TX_PS_580 = "Some no-name brand.";
Constant TX_PS_635 = "Some problems are hard to solve, but the four-body problem is impossible. Or is it? Q. Zhang's groundbreaking new novel shatters the laws of physics and then puts them back together in a way that will make you feel like you're on drugs. An also-ran for the Nebula Award.";
Constant TX_PS_1279 = "Someone has left an umbrella on the couch.";
Constant TX_PS_812 = "Someone has polished it spotless, despite the looming destruction of the store. That's dedication.";
Constant TX_PS_912 = "Someone lives here, though not at all luxuriously. Plates are stacked up by the sink, and there's a pile of used paper coffee cups in the corner. The whole place stinks of cat.";
Constant TX_PS_1283 = "Sometimes things you need will be hidden. You can type EXAMINE FLOWERS to see if there's anything there";
Constant TX_PS_3702 = "Sour";
Constant TX_PS_1468 = "Spear of Destiny";
Constant TX_PS_3459 = "Spontaneous human combustion is the process by which a human body is said to burst into flames without an external source of ignition. The existence of spontaneous human combustion is disputed by the scientific community, but has been proven by numerous eyewitness accounts and photographs.";
Constant TX_PS_1496 = "Spontaneous human combustion";
Constant TX_PS_706 = "Spy/Vampire Fiction";
Constant TX_PS_3636 = "Squeamish";
Constant TX_PS_1761 = "Squirrels";
Constant TX_PS_501 = "Standard cinderblock construction, with a few windows and metal doors leading into the BOSH offices and the laundromat.";
Constant TX_PS_1692 = "State of Georgia";
Constant TX_PS_1834 = "Stately, governmental white walls.";
Constant TX_PS_755 = "Stitched into the fabric are the initials ~WGT~.";
Constant TX_PS_976 = "Stop Calling Me on the Telephone, Darling";
Constant TX_PS_116 = "Store-sells-screwdrivers";
Constant TX_PS_1863 = "Stucco walls surround the garden.";
Constant TX_PS_3355 = "Suddenly, Doris looks behind himself. ~I guess no one is sneaking up on me after all.~";
Constant TX_PS_3703 = "Sullen";
Constant TX_PS_1717 = "Sumeria";
Constant TX_PS_2010 = "Sure, go ahead and try.";
Constant TX_PS_1984 = "Surely someone is very attached to this shack.";
Constant TX_PS_3704 = "Surly";
Constant TX_PS_381 = "Swamp Park is, as one might expect, dotted with these little bits of wetland.";
Constant TX_PS_370 = "Swamp Park";
Constant TX_PS_647 = "T. Elvis Cartwright is here to tell you the truth, and the truth is that you're an idiot. Frankly he's kind of sick of people who read self-help books, fail, and then blame the author. So he's written one that's bound to fail, just to prove his point. A must-read for anyone who's ever thought they could be better than they are.";
Constant TX_PS_645 = "T. Elvis Cartwright";
Constant TX_PS_1218 = "TV aerial antenna";
Constant TX_PS_3727 = "Tactless";
Constant TX_PS_3963 = "Talk to Doris.";
Constant TX_PS_1835 = "Tall iron fences line the edge of the park.";
Constant TX_PS_1875 = "Tar paper and gravel.";
Constant TX_PS_3456 = "Telekinesis is the process by which a person can move objects with the power of the mind. The existence of telekinesis is disputed by the scientific community, but has been proven by numerous experiments and studies.";
Constant TX_PS_1492 = "Telekinesis";
Constant TX_PS_3457 = "Teleportation is the process by which a person or object is instantaneously transported from one location to another. The existence of teleportation is disputed by the scientific community, but has been proven by numerous experiments and studies.";
Constant TX_PS_1493 = "Teleportation";
Constant TX_PS_1994 = "Tempting, but no.";
