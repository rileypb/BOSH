Constant TX_PS_2149 = "~What do you think of Maggie?~";
Constant TX_PS_2287 = "~What do you think of Minerva?~";
Constant TX_PS_2274 = "~What do you think of Ronald Reagan?~";
Constant TX_PS_2257 = "~What do you think of the Beatles?~";
Constant TX_PS_2260 = "~What do you think of the Dave Clark Five?~";
Constant TX_PS_2272 = "~What do you think of the Vietnam War?~";
Constant TX_PS_2335 = "~What do you want with Daniels?~ asks Faraji.";
Constant TX_PS_2334 = "~What do you want with me?~ asks Faraji.";
Constant TX_PS_2144 = "~What does any of this have to do with me?~";
Constant TX_PS_2894 = "~What does it mean to be a cat's owner?~ Hutz replies.";
Constant TX_PS_2310 = "~What does your shirt say?~";
Constant TX_PS_2171 = "~What happened in Pompeii with Klimp?~";
Constant TX_PS_2225 = "~What is Atlantis?~";
