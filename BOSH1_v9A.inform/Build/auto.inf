Constant TX_PS_608 = "Moira Zin";
Constant TX_PS_3477 = "Moira crosses her arms. ~This new office suite is a bit of a downgrade from the old one. We'll have to make do.~";
Constant TX_PS_3472 = "Moira looks pensive. ~I'm not sure whether Margaret is a help or a hindrance.~";
Constant TX_PS_3471 = "Moira looks serious. ~I'm worried about the Chief. He's been acting strange lately. But I guess that's nothing new.~";
Constant TX_PS_3474 = "Moira peeks into the closet. ~I'm not sure what to do with this closet. I don't have much to store in it.~";
Constant TX_PS_3473 = "Moira says, ~Feel free to borrow a book if you like. Just take good care of it.~";
Constant TX_PS_3475 = "Moira sits on the edge of her desk. ~Klimp was telling me about the Voynich manuscript. Fascinating stuff.~";
