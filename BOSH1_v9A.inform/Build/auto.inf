Constant TX_PS_2211 = "~What is the Spear of Destiny?~";
Constant TX_PS_2206 = "~What is the Voynich Manuscript?~";
Constant TX_PS_2214 = "~What is the White House?~";
Constant TX_PS_2182 = "~What is the Yeti?~";
Constant TX_PS_2176 = "~What is the astral plane?~";
Constant TX_PS_2139 = "~What is the auxiliary portal?~";
Constant TX_PS_2285 = "~What is the hyperspace field office?~";
Constant TX_PS_2138 = "~What is the portal to the past?~";
Constant TX_PS_2288 = "~What is the thumb drive?~";
Constant TX_PS_2145 = "~What is this place?~";
Constant TX_PS_643 = "~What is this thing that tortures and delights me so?~ Ender Fatum's award-winning novel asks that question and more, yet somehow manages to avoid answering any of them. A quagmire of a book that will leave you questioning your own sanity and the nature of reality itself. A must-read for fans of Kafka, Lovecraft, and Samuel Delany.";
Constant TX_PS_2148 = "~What was that place I had to walk through to get here?~";
Constant TX_PS_2197 = "~What was the Betty and Barney Hill Abduction?~";
Constant TX_PS_2194 = "~What was the Confederacy?~";
Constant TX_PS_2201 = "~What was the Dyatlov Pass Incident?~";
Constant TX_PS_2190 = "~What was the Kelly-Hopkinsville Encounter?~";
Constant TX_PS_2203 = "~What was the Mary Celeste?~";
Constant TX_PS_2184 = "~What was the Moberly-Jourdain Incident?~";
Constant TX_PS_2380 = "~What was the Mothm--~";
Constant TX_PS_2204 = "~What was the Philadelphia Experiment?~";
Constant TX_PS_2195 = "~What was the Rendlesham Forest Incident?~";
Constant TX_PS_2179 = "~What was the Roswell Incident?~";
Constant TX_PS_2200 = "~What was the Tunguska Event?~";
Constant TX_PS_2196 = "~What were the Phoenix Lights?~";
Constant TX_PS_2326 = "~What's Dragnet about?~ Faraji asks.";
Constant TX_PS_2251 = "~What's a Magic 8-Ball?~";
Constant TX_PS_2250 = "~What's a Ouija board?~";
Constant TX_PS_2290 = "~What's in your sketchbook?~";
Constant TX_PS_2289 = "~What's on your desk?~";
Constant TX_PS_2291 = "~What's that pencil?~";
Constant TX_PS_2166 = "~What's the color cube?~";
Constant TX_PS_2324 = "~What's the deal with Daniels?~ Faraji asks.";
Constant TX_PS_2321 = "~What's the deal with Henry's Hot Skillet?~ Faraji asks.";
Constant TX_PS_2322 = "~What's the deal with the astral resonator?~ Faraji asks.";
Constant TX_PS_2323 = "~What's the deal with the lizard people?~ Faraji asks.";
Constant TX_PS_2315 = "~What's the sledgehammer for?~ Faraji asks.";
Constant TX_PS_2387 = "~What's this I hear about the --~";
Constant TX_PS_2156 = "~What's this one about?~";
Constant TX_PS_2133 = "~What's this?~";
Constant TX_PS_2316 = "~What's with all the dirty dishes?~ Faraji asks.";
Constant TX_PS_2318 = "~What's with the narrow bed?~ Faraji asks.";
Constant TX_PS_2341 = "~What's with the root vegetables?~ asks Faraji.";
Constant TX_PS_2336 = "~What's with the rutabaga?~ asks Faraji.";
Constant TX_PS_2340 = "~What's with the woven basket?~ asks Faraji.";
Constant TX_PS_2896 = "~What's with your ugly face?~ Hutz replies.";
Constant TX_PS_2325 = "~What's your favorite TV show?~ Faraji asks.";
Constant TX_PS_2880 = "~What? Are you robbing the place? Don't hurt me!~";
Constant TX_PS_3228 = "~What? Stop confusing me with all these questions.~";
Constant TX_PS_3025 = "~What? Zombies? I can't hear you. Speak up. Zombies? Oh, zombies. They're not very good conversationalists. They're not very good at anything.~";
Constant TX_PS_2920 = "~What?~ hisses the lizard person. ~We have no interest in woven baskets.~";
Constant TX_PS_2379 = "~Whatever happened to your --~";
Constant TX_PS_2725 = "~Whatever she is, she's not in Enigma Lake.~";
Constant TX_PS_3005 = "~White House? Of course. It's at the conjunction of ley lines. Those things attract the Illuminati like flies to vinegar. Or is it honey? I can't remember.~";
Constant TX_PS_2283 = "~Who are the Onondaga?~";
Constant TX_PS_2328 = "~Who are you?~ asks Faraji.~";
Constant TX_PS_2141 = "~Who are you?~";
Constant TX_PS_2741 = "~Who even knows? It's all a blur. I wasn't involved.~";
Constant TX_PS_2136 = "~Who is Christy?~";
Constant TX_PS_2282 = "~Who is Daniels, anyway?~";
Constant TX_PS_2135 = "~Who is Doris?~";
Constant TX_PS_2161 = "~Who is Maggie?~";
Constant TX_PS_2137 = "~Who is Minerva?~";
Constant TX_PS_2332 = "~Who is the Dragon?~ asks Faraji.";
Constant TX_PS_2159 = "~Who is the Mothman?~";
Constant TX_PS_2781 = "~Who thought that was a good idea? I mean, really. A guy who turns into a wolf? That's just silly.~";
Constant TX_PS_2205 = "~Who was Amelia Earhart?~";
Constant TX_PS_2198 = "~Who was Benny Hill?~";
Constant TX_PS_2193 = "~Who was Colonel Sanders?~";
Constant TX_PS_2276 = "~Who was Davy Jones?~";
Constant TX_PS_2263 = "~Who was Groucho Marx?~";
Constant TX_PS_2192 = "~Who was Jefferson Davis?~";
Constant TX_PS_2247 = "~Who was John Lennon?~";
Constant TX_PS_2277 = "~Who was Mike Nesmith?~";
Constant TX_PS_2242 = "~Who was Nikola Tesla?~";
Constant TX_PS_2221 = "~Who was Thomas Edison?~";
Constant TX_PS_2246 = "~Who was V I Lenin?~";
Constant TX_PS_2264 = "~Who were the Marx Brothers?~";
Constant TX_PS_2261 = "~Who were the Ramones?~";
Constant TX_PS_3159 = "~Who? Oh, the guy who played Doogie Howitzer on that show about the doctor. I think he was in a band with John Lennon.~";
Constant TX_PS_3173 = "~Who? You mean the guy who hosted American Grandstand? How old do you think I am?~";
Constant TX_PS_2745 = "~Why are you asking about him? He's not important. He's not in Enigma Lake.~";
Constant TX_PS_2798 = "~Why are you asking me about Woonsocket? It's not in Enigma Lake.~";
Constant TX_PS_1533 = "~Why not? I don't understand a word of it anyway.~";
Constant TX_PS_2317 = "~Why so many coffee cups?~ Faraji asks.";
Constant TX_PS_3190 = "~Why? What did Klimp tell you?~";
Constant TX_PS_3220 = "~Woonsocket is a city in Rhode Island. It is known for its historic architecture, its cultural institutions, and its annual autumn festival. There is no scientific evidence to support the idea that it is a portal to another dimension.~";
Constant TX_PS_3195 = "~World War II was a global conflict that lasted from 1939 to 1945. It involved most of the world's nations and was the deadliest conflict in human history. There is no scientific evidence to support the idea that it was caused by lizard people, vampires, or robots.~";
Constant TX_PS_2738 = "~Worst place I've ever been for scuba diving. I don't recommend it.~";
Constant TX_PS_3169 = "~Yeah, Ramone the Pest. I read that as a kid. It's about a kid who gets a pet rat. It's a good book.~";
Constant TX_PS_3045 = "~Yeah, all the lines, right? They're ley lines, which are, well, kind of like these lines of energy that connect the world. They're like the veins of the Earth. They're like the nervous system of the Earth. They're like the internet of the Earth. No, I take that back. Let's stick with the veins metaphor.~";
Constant TX_PS_3042 = "~Yes, I do. Have you checked out the new article about the Marfa Lights? It's a doozy.~";
Constant TX_PS_2712 = "~Yes, I do. Western Pennsylvania 12-and-under speed champion three years running.~";
Constant TX_PS_2720 = "~Yes, I have. It was Constantinople when I was there. It's a long story.~";
Constant TX_PS_2699 = "~Yes, I have. It's a good book.~";
Constant TX_PS_2702 = "~Yes, I know who you are. Doris told me you were coming.~";
Constant TX_PS_3156 = "~Yes, I was. But I left to join the Bureau of Strange Happenings. They do more important work. And they have a better vision plan.~";
Constant TX_PS_366 = "~Yes, my pencil is a screwdriver. Ha. Ha. I'm working here.~";
Constant TX_PS_2681 = "~Yes, that's the one. Isn't it lovely?~";
Constant TX_PS_2954 = "~Yes, yes, east and then north. I'm busy.~";
Constant TX_PS_2977 = "~Yes, yes, the Jersey Devil. It's a kangaroo. A kangaroo with wings. From another world.~";
Constant TX_PS_2710 = "~Yes. Please don't speculate on what it says about my psyche. I'm very sensitive.~";
Constant TX_PS_2693 = "~Yet another temporal paradox waiting to happen. I'm surprised we haven't all been sucked into a black hole yet.~";
Constant TX_PS_3252 = "~Yoko Ono is a Japanese multimedia artist, singer, and peace activist who is best known for her marriage to John Lennon. She is also known for her avant-garde art and music. There is no scientific evidence to support the idea that she is the reincarnation of Rasputin.~";
Constant TX_PS_984 = "~You are my silly little guy, and I am your silly little girl, and we are silly together in our silly little world.~";
Constant TX_PS_2163 = "~You certainly have, uh, a lot of stuff on your desk.~";
Constant TX_PS_2782 = "~You ever really try to relate to a zombie? I mean really try? Maybe someday you should, just to see what it's like. ~Cause it's not pleasant, not at all.~";
Constant TX_PS_2869 = "~You ever seen one of these before? It makes light. I'll sell it to you for six bucks.~";
Constant TX_PS_2154 = "~You have a nice libarary.~";
Constant TX_PS_2308 = "~You like working here?~";
Constant TX_PS_3037 = "~You mean the eighties band? I like them. They had a song about a huge alien jellyfish. Or maybe that was someone else. But you meant the Church of Scientology, didn't you? They're weird.~";
Constant TX_PS_2797 = "~You must work for Klimp. No. There are no aliens on Earth. If there are, why hasn't anyone noticed?~";
Constant TX_PS_2281 = "~You really talked to Dwight Eisenhower?~";
Constant TX_PS_2306 = "~You selling the stuff in this case?~";
Constant TX_PS_2859 = "~You want something inside, just ask.~";
Constant TX_PS_2870 = "~You want the screwdriver? Five bucks. And no, you can't borrow it.~";
Constant TX_PS_2930 = "~You're an agent investigating strange occurrences in the United States and its territories,~ Doctor Helpful replies.";
Constant TX_PS_3064 = "~You're going to ask about the Dictionary of Strangeness, aren't you? Fine. I've read it cover to cover. Know everything there is to know about everything one should know about. Ask me anything.~";
Constant TX_PS_2949 = "~You're just disoriented from the move,~ Margaret says. ~It'll get better.~";
Constant TX_PS_935 = "~You're looking for the secret of Enigma Lake, are you not? The secret about to be lost forever? Something calls you here; you're searching for something, no, someone. Yes, yes, Hutz can help you.~";
Constant TX_PS_2743 = "~You're not from military intelligence, are you? If you are, you have to tell me. It's the law. Anyway, my sources tell me it was a weather balloon. A shiny weather balloon with lights on a mile-long string.~";
Constant TX_PS_2883 = "~You're not telling a joke, are you? ~Cause if you are, I'll have to get indignant and defensive about my mom.~";
Constant TX_PS_3140 = "~Zombies are reanimated corpses that are said to feed on the flesh of the living. They are a popular subject in folklore, literature, and popular culture. There is no scientific evidence to support the existence of zombies.~";
Constant TX_PS_3033 = "~alien jellyfish in the Sargasso Sea? As much as anyone, which is to say, not much. But it's there. Somebody told me.~";
Constant TX_PS_3018 = "~ancient astronauts? I can't remember. I used to. I used to believe in them. I used to believe in them a lot. I used to believe in them so much that I thought I was one. Now, I'm not so sure.~";
Constant TX_PS_3027 = "~anyone who can levitate? Well, that's a good question. I used to. But they fell down, so I don't know anymore.";
Constant TX_PS_3066 = "~bears? Because they're dangerous. They're everywhere. They're in the woods. They're in the cities. They're in the mountains. They're in the oceans. Everywhere.~";
Constant TX_PS_3039 = "~boards are real? Yes. No. Goodbye. At any rate, they're more reliable than the Magic 8-Ball.~";
Constant TX_PS_3020 = "~circles are of alien origin? Maybe. But I'm more interested in crop squares. Or crop trapezoids. Or crop dododecahedrons. Those are the real mystery. I think it's the the Illuminati. They use them to communicate with the Black Knight Satellite.~";
Constant TX_PS_3008 = "~crystals? Yes, I have. I've used them to heal, to divine, to communicate with the Black Knight Satellite. I've used them to find lost keys. I've used them to find lost time. I've used them to find lost socks. I once gave one to a lonely Sasquatch. It didn't seem to care for it.~";
Constant TX_PS_3067 = "~damn phone that keeps ringing? It's the Illuminati. They're trying to get you. They're trying to get me. They're trying to get everyone. Don't answer it. But make it stop. It's driving me crazy.~";
Constant TX_PS_3009 = "~den jars? I don't know. You might want to ask Nikola Tesla. He was into that sort of thing. Or was it Thomas Edison? I can't remember. But you were going to ask about ley lines, weren't you? I have them all mapped out on my globe.~";
Constant TX_PS_3010 = "~den jars? Not a clue. You might want to ask Nikola Tesla. He was into that sort of thing. Or was it Thomas Edison? I can't remember.~";
Constant TX_PS_3029 = "~invent a teleporter? Nah, too dangerous. You could end up in another world. Or another time. Or in the middle of the Sargasso Sea. Or smack dab in the middle of the Tunguska Event. Now wouldn't that be something?~";
Constant TX_PS_3015 = "~lanta? It's a city in Georgia. Oh, you mean the lost city of Atlantis. It's really just a metaphor. For something. I can't remember what. But it's a metaphor. For something.~";
Constant TX_PS_3013 = "~masons? Harmless. They're harmless. They're just a bunch of guys who like to wear aprons and have secret handshakes. It's not like they have the Holy Grail or anything. That's a myth. I think.~";
Constant TX_PS_3063 = "~onsocket? Isn't that a funny name? I mean, what's a woon, anyway? But what were we talking about?";
Constant TX_PS_3242 = "~robots? I don't trust them. They don't have eyelids.~";
Constant TX_PS_3215 = "~sbury Doughboy? He's so cute. I just want to poke him in the belly. But I can't. Because he's not real. Just like the Piltdown Man.~";
Constant TX_PS_3012 = "~scopes? Yes, I do. I've seen the evidence. I've seen the evidence that they're real. I've seen the evidence that they're fake. I've seen the evidence that they're a tool of the Illuminati. None of it makes sense. But I still believe in them.~";
Constant TX_PS_3030 = "~spontaneous human combustion is real? Yes, I do, and when people say it's not, it really burns me up. LOL.";
Constant TX_PS_3036 = "~still alive? Most definitely. He's living in a hidden city on the inside of the earth. Somewhere it's always 1969.~";
Constant TX_PS_3040 = "~works? Well, yes, in a manner of speaking. But not for what you think. No, not at all.~";
Constant TX_PS_3370 = "*";
Constant TX_PS_3371 = "+";
Constant TX_PS_1812 = ", ";
Constant TX_PS_1813 = ", and ";
Constant TX_PS_3369 = "-";
Constant TX_PS_2130 = ". ";
Constant TX_PS_3496 = "1, 2, or 3? > ";
