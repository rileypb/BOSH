    ParaContent(); print "There is a glow-in-the-dark light switch on the wall here, currently ";! [6: if the light switch is switched on]

    	if (~~(((((Adj_123_t1_v10(I473_light_switch))))))) jump L_Say962;! [7: ~on~]
    ParaContent(); print "on";! [8: otherwise]

    	jump L_SayX930; .L_Say962;! [9: ~off~]
    ParaContent(); print "off";! [10: end if]

    	.L_Say963; .L_SayX930;! [11: ~.~]
