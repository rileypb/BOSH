! ----------------------------------------------------------------------------------------------------
! From "Enigma Lake" by Philip Riley
! No specific request
! Rule for constructing the status line when the location is the old root cellar and the group of lizard people is in the old root cellar:
[ R_2027 I7RBLK;
    @push I7SFRAME;
    StackFrameCreate(2);
    BlkValueCreateOnStack(0, TEXT_TY);
    I7RBLK = KERNEL_55();
    BlkValueFreeOnStack(0);
    @pull I7SFRAME;
    return I7RBLK; ! nothing
];
