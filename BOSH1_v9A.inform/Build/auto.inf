Constant TX_PS_1338 = "Doctor Helpful for the book";
Constant TX_PS_1295 = "Doctor Helpful is a tweedy old professor with ink-stained fingers.";
Constant TX_PS_1294 = "Doctor Helpful";
Constant TX_PS_1336 = "Doctor Helpful's fingers are stained with ink.";
Constant TX_PS_4031 = "Does Faraji have any way of getting out of Enigma Lake?";
Constant TX_PS_4116 = "Does Faraji know of any things having to do with focus?";
Constant TX_PS_141 = "Doing nothing";
Constant TX_PS_1937 = "Don't be silly.";
Constant TX_PS_3540 = "Don't forget to examine the computer.";
