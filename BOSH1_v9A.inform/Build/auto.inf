Constant TX_PS_722 = "Josef K. covers everything from sledgehammer design to sledgehammer fashion in the definitive guide to sledgehammers. NOT FOR SALE TO THE EXCESSIVELY ANGRY.";
Constant TX_PS_721 = "Josef K.";
