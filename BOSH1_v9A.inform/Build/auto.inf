Constant TX_PS_701 = "Bravo Sampson";
Constant TX_PS_703 = "Bravo Sampson's new book includes prayers for every occasion, from ~I need a parking space~ to ~I need to get laid.~ A must-have for anyone who's ever thought ~I need a prayer for that.~";
