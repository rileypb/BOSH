                try_from_wn = wn; g = true; while (g) {
                    g = false;
                    ! Parsing property p74_possessive
                    wn = try_from_wn; spn = parsed_number; ss = etype; if ((TEXT_TY_ROGPR(self.p74_possessive) == GPR_PREPOSITION)){
