Constant TX_PS_3454 = "Invisibility is the state of an object that cannot be seen. A number of invisibility technologies have been developed, including metamaterials, cloaking devices, and optical camouflage. Examples of applications of invisibility technologies include military stealth aircraft, and Harry Potter's invisibility cloak.";
Constant TX_PS_1490 = "Invisibility";
