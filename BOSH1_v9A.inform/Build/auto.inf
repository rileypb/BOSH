    ! [6: clear behavior of margaret]
    (PHR_1106_r119 (I503_margaret_chao));
    ! [7: add behavior walking-to to margaret]
    (PHR_1107_r24 (I202_walking_to,I503_margaret_chao));
    ! [8: add behavior locking-back-door to margaret]
    (PHR_1107_r24 (I1191_locking_back_door,I503_margaret_chao));
    ! [9: add behavior waiting-for-player to margaret]
    (PHR_1107_r24 (I1192_waiting_for_player,I503_margaret_chao));
    } else if (debug_rules > 1) DB_Rule(R_2585, 2585, 'action');
