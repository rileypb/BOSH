Constant TX_PS_176 = "Descending Stair";
Constant TX_PS_666 = "Described by many as ~the book Woodlouse probably shouldn't have written,~ Mister Whimsy is an only barely endurable ~comedy~ about the titular character's trying experiences tutoring the nauseating spawn of the rich and famous. Out of print for sixty years, it has inexplicably been reissued.";
