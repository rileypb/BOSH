    ! [3: silently try margaret unlocking the bosh back door with the white key]
    @push keep_silent; keep_silent=1; @push say__p; @push say__pc;
    ClearParagraphing(1);
    TryAction(0, I503_margaret_chao, ##Unlock, I512_bosh_back_door, I1186_white_key);
    DivideParagraphPoint();
    @pull say__pc; @pull say__p; AdjustParagraphPoint(); @pull keep_silent;

    ! [4: silently try margaret opening the bosh back door]
