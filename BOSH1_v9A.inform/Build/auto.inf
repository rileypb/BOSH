Constant TX_PS_1446 = "Sasquatch";
Constant TX_PS_3412 = "Sasquatch, also known as Bigfoot, is a cryptid from the forests of the Pacific Northwest. It is described as a large, hairy, bipedal humanoid. Although skeptics argue against its existence, the preponderance of the evidence suggests that it is a real creature.";
